---
// **右下に出る追従 CTA（LP KIT）。**
//
// **画面下端は使わない。** 記事ページには忍者AdMAX の固定枠が居る（z-index 90）ので、
// 重なると広告も CTA も押せなくなる。CSS 側で 76px 上に逃がしてある。
//
// スクロールしてから出す。**出しっぱなしにしない**（読み始めの邪魔をしない）。
export interface Props {
  href?: string;
  label?: string;
  /** これだけスクロールしたら出す（px） */
  after?: number;
}
const { href = '/category/campaigns/', label = '今日のお得を見る', after = 900 } = Astro.props;
---

<a class="lp-float" href={href} data-lp-float data-after={after}>
  <span aria-hidden="true">🔥</span>{label}
</a>

<script is:inline>
  (function () {
    var el = document.querySelector('[data-lp-float]');
    if (!el) return;
    var after = parseInt(el.getAttribute('data-after') || '900', 10);
    // **`scroll` を直に聞かない。** 1 スクロールで何十回も走るので
    // `requestAnimationFrame` で 1 フレーム 1 回にまとめる
    var ticking = false;
    function apply() {
      ticking = false;
      el.classList.toggle('is-on', window.scrollY > after);
    }
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    }, { passive: true });
    apply();
  })();
</script>
