---
// 広告の横に並べる「成果報酬つきの比較記事」への案内カード（2026-10-31 利用者の指示）。
// PC では広告（300×250）と横に 2 つ並び、スマホでは縦に積む（.ad-pair が折り返す）。
// 大きさは広告に合わせて 300×250 前後。中身は自分の記事なので、審査も設置数の上限も無い。
import type { CollectionEntry } from 'astro:content';
import { getPrimaryCategory } from '../lib/category';

export interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const cat = getPrimaryCategory(post.data);
const categoryFallback: Record<string, string> = {
  campaigns: '/images/eyecatch/campaigns.jpg',
  services: '/images/eyecatch/services.jpg',
  comparisons: '/images/eyecatch/comparisons.jpg',
  roundups: '/images/eyecatch/roundups.jpg',
  howto: '/images/eyecatch/howto.jpg',
  'wangan-life': '/images/eyecatch/services.jpg',
};
const image = post.data.eyecatch?.src ?? post.data.eyecatchUrl ?? categoryFallback[cat] ?? '/images/eyecatch/services.jpg';
// 題名の「｜」より前を見出しに、後ろを添え書きにする（長い題名で 2 行に収まらないため）
const [head, ...rest] = post.data.title.split('｜');
const sub = rest.join('｜');
---

<a class="promo-card" href={`/posts/${post.id}/`} data-promo={post.id}>
  <span class="promo-card__img"><img src={image} alt="" loading="lazy" width="300" height="169" /></span>
  <span class="promo-card__body">
    <span class="promo-card__label">比べて選ぶ</span>
    <span class="promo-card__title">{head}</span>
    {sub && <span class="promo-card__sub">{sub}</span>}
    <span class="promo-card__go">比較を見る →</span>
  </span>
</a>

<style>
  .promo-card {
    display: flex;
    flex-direction: column;
    width: 300px;
    max-width: 100%;
    min-height: 250px;
    background: #fff;
    border: 1px solid var(--pink-200);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow-card);
    transition: transform 0.15s, border-color 0.15s;
  }
  .promo-card:hover { transform: translateY(-2px); border-color: var(--pink-500); }
  .promo-card:focus-visible { outline: 2px solid var(--pink-600); outline-offset: 2px; }
  .promo-card__img { display: block; aspect-ratio: 16 / 9; background: var(--pink-50); }
  .promo-card__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .promo-card__body { display: flex; flex-direction: column; gap: 4px; padding: 10px 14px 12px; flex: 1; }
  .promo-card__label { font-size: 11px; font-weight: 700; color: var(--pink-700); letter-spacing: 0.05em; }
  .promo-card__title {
    font-size: 14px; font-weight: 700; line-height: 1.45;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .promo-card__sub {
    font-size: 12px; color: var(--ink-2); line-height: 1.45;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }
  .promo-card__go { margin-top: auto; font-size: 12px; font-weight: 700; color: var(--pink-600); }
</style>
