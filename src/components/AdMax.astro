---
// 忍者AdMAX 広告ユニット
// 単一 slot (sidebar / sticky-mobile) または PC/SP ペア slot に対応
import { ADMAX_TAGS, isAdMaxConfigured } from '../data/admax-tags';

export interface Props {
  slot?: string;        // 単一 slot（SP専用 or PC専用 で完結する場合）
  pcSlot?: string;      // ペアモード: PC 用 slot
  spSlot?: string;      // ペアモード: SP 用 slot
  variant?: 'inline' | 'sticky-mobile' | 'sidebar';
  label?: boolean;
}

const { slot, pcSlot, spSlot, variant = 'inline', label = true } = Astro.props;

const singleHtml = slot ? (ADMAX_TAGS[slot] ?? '') : '';
const pcHtml = pcSlot ? (ADMAX_TAGS[pcSlot] ?? '') : '';
const spHtml = spSlot ? (ADMAX_TAGS[spSlot] ?? '') : '';

const enabled =
  (slot && isAdMaxConfigured(slot)) ||
  (pcSlot && isAdMaxConfigured(pcSlot)) ||
  (spSlot && isAdMaxConfigured(spSlot));
---

{enabled ? (
  <aside class={`admax admax--${variant}`} aria-label="広告">
    {label && <span class="admax__label">スポンサーリンク</span>}
    {slot && <div class="admax__container" set:html={singleHtml}></div>}
    {pcSlot && isAdMaxConfigured(pcSlot) && (
      <div class="admax__pc" set:html={pcHtml}></div>
    )}
    {spSlot && isAdMaxConfigured(spSlot) && (
      <div class="admax__sp" set:html={spHtml}></div>
    )}
  </aside>
) : (
  <div class="admax-placeholder" aria-hidden="true"></div>
)}

<style>
  .admax {
    margin: 2.5rem 0;
    text-align: center;
  }
  .admax__label {
    display: block;
    font-size: 11px;
    color: var(--ink-3);
    margin: 0 0 6px;
    letter-spacing: 0.05em;
  }
  .admax__container,
  .admax__pc,
  .admax__sp {
    display: block;
    min-height: 50px;
  }
  /* inline（ペア）モード: PC 幅では PC タグ、SP 幅では SP タグを表示 */
  @media (min-width: 880px) {
    .admax__sp { display: none; }
  }
  @media (max-width: 879px) {
    .admax__pc { display: none; }
  }
  .admax--sidebar { margin: 1rem 0; }
  /* sidebar は PC 専用なので SP ではコンテナごと非表示にして余白も消す */
  @media (max-width: 879px) {
    .admax--sidebar { display: none; }
  }
  .admax--sticky-mobile {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    margin: 0;
    padding: 4px 0 max(4px, env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(6px);
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.06);
    text-align: center;
  }
  .admax--sticky-mobile .admax__label { font-size: 10px; margin-bottom: 2px; }
  @media (min-width: 880px) {
    .admax--sticky-mobile { display: none; }
  }
  .admax-placeholder { display: none; }
</style>
