---
/**
 * ランキングの一覧ページ（/category/rankings/）の見せ方（2026-11-15 利用者「見た目の面白さや回遊して見ようとするメリットがいっさいない」）。
 * 参考にしたもの: 外務省キッズ「世界いろいろ雑学ランキング」（1位を「？」で隠すピックアップ・ジャンルごとの色の帯）、
 * みんなのランキング（1〜3位のカードと「4位以降を見る」・写真のジャンルのタイル）、家庭学習レシピ（表彰台の見出し）、
 * TABIZINE（「〜はどこ？」の問いの見出し）。数字は src/data/rankings-index.json（各記事の順位表から写したもの）。
 */
interface Top { rank: number; name: string; value: string }
interface Item { slug: string; topic: string; first: string; value: string; source: string; q: string; top3: Top[]; img?: string }
interface Group { name: string; items: Item[] }
interface Props { groups: Group[]; pickSlug?: string }
const { groups, pickSlug = 'lalaport-guide-2026' } = Astro.props;

const all = groups.flatMap((g) => g.items);
const pick = all.find((i) => i.slug === pickSlug) ?? all[0];
const quizzes = all.filter((i) => i.slug !== pick.slug).slice(0, 8);
const STYLE: Record<string, { c: string; soft: string; icon: string; id: string; en: string }> = {
  'お店・商業施設': { c: '#e0457b', soft: '#fdf1f5', icon: '🛍️', id: 'g-shop', en: 'SHOP & MALL' },
  '交通': { c: '#2f80d1', soft: '#eef5fc', icon: '🚃', id: 'g-traffic', en: 'TRANSPORT' },
  '観光・宿泊': { c: '#1f9d6b', soft: '#edf7f2', icon: '♨️', id: 'g-travel', en: 'TRAVEL & STAY' },
  'スポーツ・まち': { c: '#e88a1a', soft: '#fdf5ea', icon: '⚾', id: 'g-sports', en: 'SPORTS & CITY' },
};
const st = (n: string) => STYLE[n] ?? { c: '#6b5ca5', soft: '#f3f0fa', icon: '🏆', id: 'g-' + encodeURIComponent(n), en: 'RANKING' };
const medal = (r: number) => (r === 1 ? 'gold' : r === 2 ? 'silver' : 'bronze');
---

<div class="rks">
  <!-- 表彰台の見出し -->
  <div class="rks-hero" aria-hidden="false">
    <div class="rks-hero-text">
      <p class="rks-kicker">公式の数字だけで並べた</p>
      <p class="rks-title">数字で見る<br />ニッポンのランキング</p>
      <p class="rks-sub">いま <b>{all.length}</b> のランキングを、<b>{groups.length}</b> つのジャンルで</p>
    </div>
    <div class="rks-podium" aria-hidden="true">
      <div class="p p2"><span class="crown">🥈</span><span class="n">2</span></div>
      <div class="p p1"><span class="crown">👑</span><span class="n">1</span></div>
      <div class="p p3"><span class="crown">🥉</span><span class="n">3</span></div>
    </div>
  </div>

  <!-- ジャンルのタイル -->
  <ul class="rks-genres">
    {groups.map((g) => (
      <li>
        <a href={`#${st(g.name).id}`} style={`--c:${st(g.name).c};--img:url('${g.items[0]?.img ?? ''}')`}>
          <span class="gi">{st(g.name).icon}</span>
          <span class="gn">{g.name}</span>
          <span class="gc">{g.items.length}件</span>
        </a>
      </li>
    ))}
  </ul>

  <!-- ピックアップ（1位を隠す） -->
  <div class="rks-pick">
    <span class="rks-pick-tag">ピックアップ</span>
    <div class="rks-pick-body">
      {pick.img && <img class="rks-pick-img" src={pick.img} alt="" loading="lazy" />}
      <div class="rks-pick-main">
        <p class="rks-pick-q">{pick.q}</p>
        <ol class="rks-rank">
          {pick.top3.map((t, i) => (
            <li class={medal(t.rank)}>
              <span class="r">{t.rank}<small>位</small></span>
              {i === 0 ? (
                <details class="reveal"><summary>？　タップで答えを見る</summary><span class="ans"><span class="nm">{t.name}</span><span class="v">{t.value}</span></span></details>
              ) : (
                <><span class="nm">{t.name}</span><span class="v">{t.value}</span></>
              )}
            </li>
          ))}
        </ol>
        <a class="rks-more" href={`/posts/${pick.slug}/`}>4位以降を見る →</a>
      </div>
    </div>
  </div>

  <!-- 1位はどこ？クイズ -->
  <h2 class="rks-h2" id="quiz">1位はどこ？　答えを当ててから開いてね</h2>
  <div class="rks-quiz">
    {quizzes.map((it) => (
      <details class="qz">
        <summary><span class="qmark">Q</span>{it.q}</summary>
        <p class="qa"><span class="crown">👑</span><b>{it.top3[0].name}</b>（{it.top3[0].value}）</p>
        <a href={`/posts/${it.slug}/`}>ランキングを全部見る →</a>
      </details>
    ))}
  </div>

  <!-- ジャンルごとの 1〜3 位カード -->
  {groups.map((g, gi) => (
    <section class="rks-band" id={st(g.name).id} style={`--c:${st(g.name).c};--soft:${st(g.name).soft}`}>
      <header class="rks-band-head">
        <span class="no" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</span>
        <div class="tt">
          <span class="en">{st(g.name).en}</span>
          <h2>{g.name}のランキング</h2>
        </div>
        <span class="cnt"><b>{g.items.length}</b>件</span>
      </header>
      <div class="rks-cards">
        {g.items.map((it) => (
          <article class="rk-card">
            <a class="rk-card-link" href={`/posts/${it.slug}/`}>
              {it.img && <img class="rk-thumb" src={it.img} alt="" loading="lazy" />}
              <p class="rk-q">{it.q}</p>
              <ol class="rks-rank">
                {it.top3.map((t) => (
                  <li class={medal(t.rank)}><span class="r">{t.rank}<small>位</small></span><span class="nm">{t.name}</span><span class="v">{t.value}</span></li>
                ))}
              </ol>
              <p class="rk-src">出どころ：{it.source}</p>
              <span class="rk-more">4位以降を見る</span>
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .rks { margin: 8px 0 8px; }
  .rks-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 16px; padding: 26px 28px 0; border-radius: 20px; overflow: hidden;
    background: radial-gradient(circle at 75% 20%, #fff7c2 0, transparent 45%), repeating-conic-gradient(from 0deg at 75% 110%, #ffd84d 0 6deg, #ffe683 6deg 12deg); }
  .rks-kicker { margin: 0; font-size: 13px; font-weight: 700; color: #8a5a00; letter-spacing: .06em; }
  .rks-title { margin: 4px 0 6px; font-size: clamp(26px, 5vw, 40px); font-weight: 900; line-height: 1.2; color: #2b1d00; }
  .rks-sub { margin: 0 0 24px; font-size: 14px; color: #5a4300; }
  .rks-sub b { font-size: 20px; color: #c2366c; }
  .rks-podium { display: flex; align-items: flex-end; gap: 6px; }
  .rks-podium .p { width: 74px; display: grid; justify-items: center; align-content: start; border-radius: 10px 10px 0 0; background: linear-gradient(#ffffff, #e7e7ee); box-shadow: inset 0 -6px 0 rgba(0,0,0,.06); padding-top: 6px; }
  .rks-podium .p1 { height: 136px; background: linear-gradient(#fff6d6, #f4d27a); }
  .rks-podium .p2 { height: 96px; }
  .rks-podium .p3 { height: 76px; background: linear-gradient(#fff1e6, #e9b48c); }
  .rks-podium .crown { font-size: 40px; line-height: 1; margin-top: -42px; }
  .rks-podium .n { font-size: 34px; font-weight: 900; color: #7a6b4a; margin-top: 4px; }

  .rks-genres { list-style: none; padding: 0; margin: 14px 0 22px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .rks-genres a { position: relative; display: grid; align-content: end; min-height: 96px; padding: 10px 12px; border-radius: 14px; color: #fff; text-decoration: none; overflow: hidden;
    background: linear-gradient(0deg, color-mix(in srgb, var(--c) 92%, black) 0, color-mix(in srgb, var(--c) 86%, transparent) 100%), var(--img) center/cover, var(--c); box-shadow: inset 0 -4px 0 var(--c); }
  .rks-genres a:hover { transform: translateY(-2px); }
  .rks-genres .gi { position: absolute; top: 8px; left: 10px; font-size: 22px; }
  .rks-genres .gn { font-weight: 800; font-size: 16px; text-shadow: 0 1px 3px rgba(0,0,0,.5); }
  .rks-genres .gc { font-size: 12px; opacity: .9; }

  .rks-pick { position: relative; margin: 26px 0 8px; padding: 26px 20px 20px; background: #fff; border-radius: 18px; box-shadow: 0 6px 22px rgba(0,0,0,.08); border: 1px solid #f0e6ea; }
  .rks-pick-tag { position: absolute; top: -14px; left: 16px; background: #e8352f; color: #fff; font-weight: 800; font-size: 14px; padding: 4px 16px; border-radius: 99px; }
  .rks-pick-body { display: grid; grid-template-columns: minmax(0, 260px) minmax(0, 1fr); gap: 20px; align-items: center; }
  .rks-pick-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 12px; }
  .rks-pick-q { margin: 0 0 10px; font-size: 20px; font-weight: 800; color: #1e4fa3; }

  .rks-rank { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rks-rank li { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 10px; background: #faf8f9; }
  .rks-rank .r { font-weight: 900; font-size: 20px; text-align: center; line-height: 1; }
  .rks-rank .r small { font-size: 11px; margin-left: 1px; }
  .rks-rank .gold .r { color: #c99a06; } .rks-rank .silver .r { color: #8d96a3; } .rks-rank .bronze .r { color: #b8733a; }
  .rks-rank .gold { background: #fff8dc; }
  .rks-rank .nm { font-weight: 700; font-size: 14px; min-width: 0; overflow-wrap: anywhere; }
  .rks-rank .v { font-size: 13px; font-weight: 700; color: #c2366c; white-space: nowrap; }
  .rks-rank details.reveal { grid-column: 2 / 4; }
  .reveal .ans { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
  .reveal summary { cursor: pointer; list-style: none; text-align: center; font-weight: 800; color: #1e4fa3; border: 2px solid #9db8e6; border-radius: 8px; padding: 4px 8px; background: #fff; }
  .reveal summary::-webkit-details-marker { display: none; }
  .reveal[open] summary { display: none; }
  .rks-more { display: inline-block; margin-top: 14px; padding: 8px 18px; border: 2px solid #e8352f; color: #e8352f; border-radius: 99px; font-weight: 800; text-decoration: none; font-size: 14px; }
  .rks-more:hover { background: #e8352f; color: #fff; }

  .rks-h2 { margin: 30px 0 10px; font-size: 20px; }
  .rks-quiz { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .qz { background: #fff; border: 1px solid #e8e2ea; border-radius: 12px; padding: 10px 14px; }
  .qz summary { cursor: pointer; font-weight: 700; list-style: none; display: flex; gap: 8px; align-items: baseline; }
  .qz summary::-webkit-details-marker { display: none; }
  .qz .qmark { flex: none; display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #1e4fa3; color: #fff; font-size: 13px; }
  .qz summary::after { content: '答え ▼'; margin-left: auto; flex: none; font-size: 12px; color: #1e4fa3; }
  .qz[open] summary::after { content: '閉じる ▲'; }
  .qz .qa { margin: 8px 0 4px; font-size: 15px; }
  .qz a { font-size: 13px; font-weight: 700; }

  .rks-band { margin: 40px 0 0; padding: 22px 22px 22px; background: var(--soft); border-radius: 20px; scroll-margin-top: 80px; }
  .rks-band-head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: end; gap: 14px; margin: 0 0 18px; padding-bottom: 12px; border-bottom: 1px solid color-mix(in srgb, var(--c) 28%, transparent); }
  .rks-band-head .no { font-size: 52px; font-weight: 900; line-height: .85; color: transparent; -webkit-text-stroke: 1.5px var(--c); letter-spacing: -.02em; font-family: "Helvetica Neue", Arial, sans-serif; }
  .rks-band-head .en { display: block; font-size: 11px; font-weight: 800; letter-spacing: .22em; color: var(--c); margin-bottom: 2px; }
  .rks-band-head h2 { margin: 0; font-size: 21px; line-height: 1.3; color: #22202a; }
  .rks-band-head .cnt { font-size: 12px; color: #7a7482; white-space: nowrap; padding-bottom: 3px; }
  .rks-band-head .cnt b { font-size: 20px; color: var(--c); margin-right: 1px; }
  .rks-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .rk-card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 10px rgba(0,0,0,.06); display: flex; }
  .rk-card-link { display: flex; flex-direction: column; color: inherit; text-decoration: none; width: 100%; }
  .rk-card-link:hover { background: #fffdfd; }
  .rk-thumb { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .rk-q { margin: 10px 12px 8px; font-weight: 800; font-size: 15px; line-height: 1.45; }
  .rk-card .rks-rank { margin: 0 12px; }
  .rk-card .rks-rank li { grid-template-columns: 38px minmax(0, 1fr) auto; padding: 5px 8px; }
  .rk-src { margin: 8px 12px 10px; font-size: 11px; color: #8a8290; }
  .rk-more { margin-top: auto; display: block; text-align: center; background: #2b2730; color: #fff; font-size: 13px; font-weight: 700; padding: 9px; }
  .rk-card-link:hover .rk-more { background: var(--c); }

  @media (max-width: 860px) {
    .rks-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .rks-genres { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .rks-hero { grid-template-columns: 1fr; padding: 20px 18px 0; }
    .rks-podium { justify-content: center; }
    .rks-podium .p { width: 64px; }
    .rks-pick-body { grid-template-columns: 1fr; }
    .rks-quiz { grid-template-columns: 1fr; }
    .rks-cards { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 10px; padding-bottom: 6px; margin: 0 -16px; padding-left: 16px; padding-right: 16px; }
    .rk-card { flex: 0 0 78%; scroll-snap-align: start; }
    .rks-band { padding: 18px 16px 16px; }
    .rks-band-head { gap: 10px; }
    .rks-band-head .no { font-size: 40px; }
    .rks-band-head h2 { font-size: 17px; }
    .rks-h2 { font-size: 17px; }
  }
</style>
