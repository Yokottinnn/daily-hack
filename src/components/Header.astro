---
const nav = [
  { href: '/posts/', label: '記事一覧' },
  { href: '/category/campaigns/', label: 'キャンペーン速報' },
  { href: '/category/services/', label: 'サービス紹介' },
  { href: '/category/comparisons/', label: '比較' },
  { href: '/category/howto/', label: 'ハウツー' },
  { href: '/category/roundups/', label: 'まとめ' },
  { href: '/category/wangan-life/', label: '湾岸ライフ' },
];
---

<header class="site-header">
  <div class="wrap row">
    <a href="/" class="brand" aria-label="Daily Hack ホーム">
      <span class="mark"><img src="/images/mascot-avatar.png" alt="" /></span>
      <span class="name">Daily Hack</span>
      <span class="tag">あんたバカぁ？まだ損してるの？</span>
    </a>
    <nav class="nav" aria-label="メインナビ">
      {nav.map((n) => <a href={n.href} class="item">{n.label}</a>)}
      <a href="/search/" class="item" aria-label="記事を検索">🔍</a>
      <a href="/category/campaigns/" class="cta-mini">本日のお得</a>
    </nav>
    <button
      class="hamburger"
      type="button"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      id="hamburger-btn"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<aside class="mobile-drawer" id="mobile-drawer" hidden>
  <div class="drawer-inner">
    <div class="drawer-head">
      <a href="/" class="brand" aria-label="Daily Hack ホーム">
        <span class="mark"><img src="/images/mascot-avatar.png" alt="" /></span>
        <span class="name">Daily Hack</span>
      </a>
      <button class="drawer-close" type="button" aria-label="メニューを閉じる" id="drawer-close">×</button>
    </div>
    <nav aria-label="モバイルメニュー">
      <ul class="drawer-nav">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/search/">記事を検索</a></li>
        <li><a href="/about/">Daily Hackについて</a></li>
        <li><a href="/author/">編集部プロフィール</a></li>
        <li><a href="/contact/">お問い合わせ</a></li>
        <li><a href="https://x.com/heng_ji31590" target="_blank" rel="noopener">𝕏 @heng_ji31590</a></li>
      </ul>
    </nav>
  </div>
</aside>

<script is:inline>
  (function() {
    const btn = document.getElementById('hamburger-btn');
    const drawer = document.getElementById('mobile-drawer');
    const close = document.getElementById('drawer-close');
    if (!btn || !drawer || !close) return;

    function open() {
      drawer.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => drawer.classList.add('open'));
    }
    function shut() {
      drawer.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => { drawer.hidden = true; }, 200);
    }
    btn.addEventListener('click', open);
    close.addEventListener('click', shut);
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) shut();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) shut();
    });
  })();
</script>

<style>
  .hamburger {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: transparent;
    border: 0;
    cursor: pointer;
    margin-left: auto;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2.5px;
    background: var(--ink);
    border-radius: 2px;
  }
  @media (max-width: 720px) {
    .site-header .nav { display: none; }
    .hamburger { display: flex; }
  }

  .mobile-drawer {
    position: fixed;
    inset: 0;
    background: rgba(42, 25, 35, 0.4);
    backdrop-filter: blur(4px);
    z-index: 100;
    opacity: 0;
    transition: opacity .2s ease;
  }
  .mobile-drawer.open { opacity: 1; }
  .mobile-drawer .drawer-inner {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(85vw, 360px);
    background: #fff;
    padding: 22px 24px;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform .2s ease;
    box-shadow: -8px 0 24px -12px rgba(0, 0, 0, 0.25);
  }
  .mobile-drawer.open .drawer-inner { transform: translateX(0); }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .drawer-close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pink-50);
    color: var(--ink);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    border: 0;
  }
  .drawer-close:hover { background: var(--pink-100); }
  .drawer-nav {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .drawer-nav li { border-bottom: 1px solid var(--line); }
  .drawer-nav li:last-child { border-bottom: 0; }
  .drawer-nav a {
    display: block;
    padding: 16px 4px;
    font-weight: 700;
    color: var(--ink);
    font-size: 15px;
    transition: color .15s;
  }
  .drawer-nav a:hover { color: var(--pink-500); }
</style>
