---
// 提携済み ASP（A8）のバナー（300×250）。広告の横・サイドバーの上に、記事の題材に合うものだけを出す（2026-10-31 利用者の指示）。
// 中身は A8 の広告リンク作成画面のコードそのまま（src/data/a8-banners.json）。広告なので「PR」と明示する。
export interface Props {
  html: string;
  name: string;
}
const { html, name } = Astro.props;
---

<aside class="asp-banner" aria-label={`広告（${name}）`}>
  <span class="asp-banner__label">PR</span>
  <div class="asp-banner__body" set:html={html} />
</aside>

<style>
  .asp-banner { width: 300px; max-width: 100%; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .asp-banner__label { align-self: flex-start; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; color: var(--ink-3); border: 1px solid var(--line); border-radius: 3px; padding: 0 5px; }
  .asp-banner__body { line-height: 0; max-width: 100%; overflow: hidden; }
  .asp-banner__body :global(img[width="300"]) { max-width: 100%; height: auto; }
</style>
