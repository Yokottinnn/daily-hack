---
import type { CollectionEntry } from 'astro:content';
import { getPrimaryCategory } from '../lib/category';

export interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const items = posts.slice(0, 3);

const categoryFallback: Record<string, string> = {
  campaigns: '/images/eyecatch/campaigns.jpg',
  services: '/images/eyecatch/services.jpg',
  comparisons: '/images/eyecatch/comparisons.jpg',
  roundups: '/images/eyecatch/roundups.jpg',
  howto: '/images/eyecatch/howto.jpg',
  'wangan-life': '/images/eyecatch/services.jpg',
};

const fallback = [
  { bg: '/images/eyecatch/campaigns.jpg', pill: '残り3日', title: 'Olive契約で最大30,000円還元', date: '2026-05-13', warn: false, href: '/category/campaigns/' },
  { bg: '/images/eyecatch/services.jpg', pill: '残り7日', title: '楽天モバイル新規契約で13,000pt', date: '2026-05-17', warn: false, href: '/category/campaigns/' },
  { bg: '/images/eyecatch/campaigns.jpg', pill: '期間延長', title: 'JRE BANK紹介で5,000円キャッシュバック', date: '2026-05-31', warn: true, href: '/category/campaigns/' },
];
---

<section class="urgent">
  <div class="wrap">
    <div class="sec-head">
      <h2><span class="chibi"><img src="/images/expr-06-shock.png" alt="" /></span>期限迫る！今熱いキャンペーン</h2>
      <a href="/category/campaigns/" class="seeall">すべて見る →</a>
    </div>
    <div class="articles">
      {items.length > 0 ? items.map((p) => {
        const primary = getPrimaryCategory(p.data);
        const bg = p.data.eyecatch?.src ?? p.data.eyecatchUrl ?? categoryFallback[primary] ?? '/images/eyecatch/services.jpg';
        return (
          <a href={`/posts/${p.id}/`} class="art art--compact">
            <div class="thumb">
              <img src={bg} alt={p.data.eyecatchAlt ?? ''} loading="lazy" />
              <span class="badge warn">期限迫る</span>
            </div>
            <div class="body">
              <h3>{p.data.title}</h3>
              <div class="meta">{p.data.publishDate.toISOString().slice(0, 10).replace(/-/g, '.')}</div>
            </div>
          </a>
        );
      }) : fallback.map((c) => (
        <a href={c.href} class="art art--compact">
          <div class="thumb">
            <img src={c.bg} alt="" loading="lazy" />
            <span class="badge warn">{c.pill}</span>
          </div>
          <div class="body">
            <h3>{c.title}</h3>
            <div class="meta">{c.date}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
