---
const tiles = [
  { src: '/images/life-01-cafe-read.png', label: 'カフェ作業' },
  { src: '/images/life-02-headphones.png', label: '通勤お得術' },
  { src: '/images/life-03-cooking.png', label: '自炊で節約' },
  { src: '/images/life-08-flower-shop.png', label: '小さな贅沢' },
  { src: '/images/scene-01-study-sleep.png', label: '勉強中…' },
  { src: '/images/scene-05-park-icecream.png', label: '休日' },
  { src: '/images/life-07-rainy.png', label: '雨の日' },
  { src: '/images/life-05-gaming.png', label: '夜のゲーム' },
];
---

<section>
  <div class="wrap">
    <div class="sec-head">
      <h2><span class="chibi"><img src="/images/life-02-headphones.png" alt="" /></span>ハッカー子の暮らし</h2>
      <a href="/category/howto/" class="seeall">日常コラムを見る →</a>
    </div>
    <div class="mood-grid">
      {tiles.map((t) => (
        <a href="#" class="mood-tile">
          <img src={t.src} alt="" />
          <div class="lab">{t.label}</div>
        </a>
      ))}
    </div>
  </div>
</section>
