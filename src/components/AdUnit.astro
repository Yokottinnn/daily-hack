---
// Google AdSense 広告ユニット
// 承認後、Cloudflare Pagesの環境変数 PUBLIC_ADSENSE_CLIENT に `ca-pub-XXX` を設定すると表示開始
// docs: docs/DailyHack_広告収益化ロードマップ.md

export interface Props {
  slot: string;
  format?: 'auto' | 'rectangle' | 'horizontal' | 'vertical' | 'fluid';
  responsive?: boolean;
  label?: boolean;
  layout?: 'in-article' | 'in-feed';
  layoutKey?: string;
}

const {
  slot,
  format = 'auto',
  responsive = true,
  label = true,
  layout,
  layoutKey,
} = Astro.props;

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
const enabled = client.startsWith('ca-pub-');
---

{enabled ? (
  <div class="ad-container">
    {label && <p class="ad-label">スポンサーリンク</p>}
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive={responsive ? 'true' : 'false'}
      data-ad-layout={layout}
      data-ad-layout-key={layoutKey}
    />
    <script is:inline define:vars={{ slot }}>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
) : (
  <div class="ad-placeholder" aria-hidden="true" data-ad-slot={slot}>
    <!-- AdSense 未設定のため非表示。PUBLIC_ADSENSE_CLIENT を環境変数に設定すると有効化されます。 -->
  </div>
)}

<style>
  .ad-container {
    /* **min-height を置かない。** 未配信のとき、ラベルと空欄だけが本文に残る
       （2026-09-06 のレビューで「動画の下に不自然な空白」と指摘された）。 */
    margin: 2.5rem 0;
    text-align: center;
  }
  /* AdSense が「配信なし」と判断した枠は畳む */
  .ad-container:has(ins.adsbygoogle[data-ad-status="unfilled"]) { display: none; }
  .ad-label {
    font-size: 11px;
    color: var(--ink-3);
    margin: 0 0 6px;
    letter-spacing: 0.05em;
  }
  .ad-placeholder {
    display: none;
  }
  /* DEV モードで広告枠の存在を可視化するなら以下を有効化
  :root[data-ads-debug='true'] .ad-placeholder {
    display: block;
    margin: 2.5rem 0;
    padding: 24px;
    text-align: center;
    background: repeating-linear-gradient(45deg, var(--pink-50), var(--pink-50) 10px, #fff 10px, #fff 20px);
    border: 2px dashed var(--pink-300);
    border-radius: 12px;
    color: var(--ink-3);
    font-size: 12px;
  }
  :root[data-ads-debug='true'] .ad-placeholder::after {
    content: '広告枠（slot=' attr(data-ad-slot) '）';
  }
  */
</style>
