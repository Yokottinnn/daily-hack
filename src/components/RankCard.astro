---
// **ランキングカード（LP KIT）。** 1〜3 位は金銀銅、4 位以降は装飾を落とす。
//
// 記事の Markdown から生の HTML で書いてもよい（クラスは global.css の `lp-rank`）。
// **同じ見た目を 2 箇所で持たないよう、こちらを正とする。**
//
//   <RankCard rank={1} name="楽天カード" logo="/images/.../rakuten.png"
//             copy="年会費無料でポイントが貯まりやすい" score={4.7}
//             reward="8,000" rewardLabel="新規入会＋利用で"
//             specs={[['年会費','永年無料'],['還元率','1.0%〜']]}
//             href="/posts/xxx/" cta="くわしく見る" note="※ 2026年9月時点" />
export interface Props {
  rank: number;
  name: string;
  logo?: string;
  copy?: string;
  /** 5 点満点。星の塗り幅に使う */
  score?: number;
  /** 特典の金額（単位は `rewardUnit`）。無ければ枠ごと出さない */
  reward?: string;
  rewardLabel?: string;
  rewardUnit?: string;
  /** [項目, 値] の並び */
  specs?: [string, string][];
  href?: string;
  cta?: string;
  /** 角のリボン。無ければ出さない */
  ribbon?: string;
  note?: string;
}
const {
  rank, name, logo, copy, score, reward,
  rewardLabel = '特典', rewardUnit = '円相当',
  specs = [], href, cta = 'くわしく見る', ribbon, note,
} = Astro.props;

// **1〜3 位だけ色を付ける。** 4 位以降に金銀銅を使うと順位が読めなくなる
const medal = rank >= 1 && rank <= 3 ? ` lp-rank--${rank}` : '';
// 星は 5 点満点を % に直す。**範囲の外は丸める**（データ側の事故で崩れない）。
// **点数は必ず小数 1 桁で出す。** `4.0` と書いても JS では `4` になり、
// 4.7 / 4.3 と並んだときに 1 つだけ桁が違って見える
const pct = score == null ? null : Math.max(0, Math.min(100, (score / 5) * 100));
---

<div class={`lp-rank${medal}`}>
  {ribbon && <div class="lp-ribbon"><span>{ribbon}</span></div>}
  {rank === 1 && <div class="lp-rank__crown" aria-hidden="true">👑</div>}
  <div class="lp-rank__no">{rank}<span style="font-size:11px;">位</span></div>

  <div class="lp-rank__head">
    {logo && (
      <div class="lp-rank__logo"><img src={logo} alt={`${name}のロゴ`} loading="lazy" /></div>
    )}
    <div style="min-width:0;">
      <p class="lp-rank__name">{name}</p>
      {copy && <p class="lp-rank__copy">{copy}</p>}
    </div>
  </div>

  {pct != null && (
    <div class="lp-rank__rate">
      <span class="lp-stars" style={`--pct:${pct}%`} role="img" aria-label={`5点満点中${score}点`}></span>
      <span class="lp-score"><b>{score!.toFixed(1)}</b><span>/ 5.0</span></span>
    </div>
  )}

  {reward && (
    <div class="lp-reward">
      <span class="lbl">{rewardLabel}</span>
      <span class="amt">{reward}<small>{rewardUnit}</small></span>
    </div>
  )}

  {specs.length > 0 && (
    <dl class="lp-spec">
      {specs.map(([k, v]) => (<><dt>{k}</dt><dd set:html={v} /></>))}
    </dl>
  )}

  {href && <a class="lp-cta" href={href}>{cta}<span class="arr">→</span></a>}
  {note && <p class="lp-note">{note}</p>}
</div>
