---
import { getCollection } from 'astro:content';
import { getPrimaryCategory } from '../lib/category';

export interface Props {
  slug: string;
  cta?: string;
  headline?: string;
}

const { slug, cta = '読む', headline } = Astro.props;

const all = await getCollection('posts', ({ data }) => !data.draft);
const post = all.find((p) => p.id === slug);
const primaryCat = post ? getPrimaryCategory(post.data) : null;

const categoryLabel: Record<string, string> = {
  campaigns: 'キャンペーン',
  services: 'サービス',
  comparisons: '比較',
  roundups: 'まとめ',
  howto: 'ハウツー',
  'wangan-life': '湾岸ライフ',
  rankings: 'ランキング',
};

// 2026-11-08: キャラの表情の画像は代わりの画像に使わない（キャラのアイコンはブログに出さない）。表紙の無い記事は帯を出さない
const categoryFallback: Record<string, string> = {
  campaigns: '/images/scene-04-heart.png',
  services: '/images/scene-07-grocery.png',
};

const eyecatch = post && primaryCat
  ? post.data.eyecatch?.src ?? post.data.eyecatchUrl ?? categoryFallback[primaryCat]
  : null;
---

{post && eyecatch && (
  <a class="post-banner" href={`/posts/${post.id}/`}>
    <div class="post-banner-image">
      <img src={eyecatch} alt={post.data.eyecatchAlt ?? post.data.title} loading="lazy" />
    </div>
    <div class="post-banner-body">
      {headline && <p class="post-banner-headline">{headline}</p>}
      <span class="post-banner-cat">{categoryLabel[primaryCat!] ?? primaryCat}</span>
      <p class="post-banner-title">{post.data.title}</p>
      <p class="post-banner-desc">{post.data.description}</p>
      <span class="post-banner-cta">{cta} →</span>
    </div>
  </a>
)}
