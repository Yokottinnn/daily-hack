---
/**
 * 湾岸エリアイベントマップ（2026-11-02）。湾岸ライフの一覧と /wangan-map/ に置く。
 * 地図はイラスト調の SVG（陸の形は国土地理院の地図から取った本物の海岸線）。ピンは記事の `event:` から毎朝のビルドで入れ替わる。
 * ハッカー子が「いま起きていること」をピンからピンへ案内する。動きは prefers-reduced-motion で止める。
 */
import { MAP_LAND, MAP_AREAS, MAP_LANDMARKS, MAP_SOURCE, mapItems } from '../lib/wangan-map';
import { todayJst, jpDate, jpRange } from '../lib/wangan';
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'posts'>[]; headingLevel?: 'h1' | 'h2'; title?: string }
const { posts, headingLevel = 'h2', title = '湾岸エリアイベントマップ' } = Astro.props;
const today = todayJst();
const items = mapItems(posts, today);
const events = items.filter((i) => i.kind === 'event');
const H = headingLevel;
const WARD_FILL: Record<string, string> = { 中央区: 'var(--wm-land-chuo)', 江東区: 'var(--wm-land-koto)' };
// 目印の絵（シンプルな線画）。key ごとに 1 つ
const ICON: Record<string, string> = {
  market: '<path d="M-11 6h22v-9l-11-6-11 6z" class="wm-ic-b"/><path d="M-6 -2c3-3 9-3 12 0-3 3-9 3-12 0z" class="wm-ic-a"/>',
  lalaport: '<path d="M-12 4h24l-4 6h-16z" class="wm-ic-b"/><path d="M-1 4v-14l9 10z" class="wm-ic-a"/>',
  'ariake-arena': '<path d="M-13 6a13 11 0 0 1 26 0z" class="wm-ic-b"/><path d="M-7 6a7 6 0 0 1 14 0" class="wm-ic-l"/>',
  'ariake-garden': '<rect x="-12" y="-4" width="24" height="10" rx="2" class="wm-ic-b"/><circle cx="-6" cy="-7" r="5" class="wm-ic-g"/><circle cx="5" cy="-8" r="6" class="wm-ic-g"/>',
  bigsight: '<path d="M-13 -6h10l-3 6h-4zM3 -6h10l-3 6h-4z" class="wm-ic-b"/><rect x="-13" y="0" width="26" height="6" class="wm-ic-b"/>',
  diversity: '<rect x="-11" y="-6" width="22" height="12" rx="2" class="wm-ic-b"/><path d="M-6 -6v-6h4v6" class="wm-ic-a"/>',
  triton: '<rect x="-10" y="-12" width="6" height="18" class="wm-ic-b"/><rect x="-2" y="-16" width="6" height="22" class="wm-ic-b"/><rect x="6" y="-9" width="5" height="15" class="wm-ic-b"/>',
  'harumi-flag': '<rect x="-11" y="-8" width="7" height="14" class="wm-ic-b"/><rect x="-2" y="-14" width="7" height="20" class="wm-ic-b"/><path d="M8 6v-14l6 3-6 3" class="wm-ic-a"/>',
  monja: '<ellipse cx="0" cy="2" rx="12" ry="5" class="wm-ic-b"/><path d="M-5 0c2-3 6-3 9 0" class="wm-ic-l"/><path d="M6 -8l5-4" class="wm-ic-l"/>',
  bousai: '<circle cx="-5" cy="-3" r="7" class="wm-ic-g"/><circle cx="6" cy="-1" r="6" class="wm-ic-g"/><rect x="-1" y="2" width="2" height="5" class="wm-ic-b"/>',
};
const data = JSON.stringify({ today, items });
---

<section class="wmap" aria-labelledby="wmap-title" data-wmap>
  <div class="wmap-head">
    <H id="wmap-title" class="wmap-title">{title}<span>（{jpDate(today)}時点）</span></H>
    <p class="wmap-lead">晴海・勝どき・月島・豊洲・有明・青海で<strong>いま開催中のイベントと、これから始まるイベント</strong>を地図に置いた。ピンを押すと日付・会場・料金と記事が出る。ハッカー子が開催中のものから順に案内するわよ。</p>
  </div>


  <div class="wmap-time">
    <label for="wmap-day">日付を動かす</label>
    <input id="wmap-day" type="range" min="0" max="90" value="0" step="1" />
    <output for="wmap-day" data-day-label>{jpDate(today)}</output>
    <button type="button" class="wmap-play" data-play aria-pressed="false">▶ 90日を再生</button>
  </div>

  <div class="wmap-stage" data-stage>
    <div class="wmap-canvas" data-canvas>
      <svg class="wmap-svg" viewBox="0 0 1000 1000" role="img" aria-labelledby="wmap-svg-title">
        <title id="wmap-svg-title">湾岸エリア（中央区・江東区）のイベントマップ</title>
        <defs>
          <pattern id="wm-wave" width="60" height="22" patternUnits="userSpaceOnUse">
            <path d="M2 14c6-6 12-6 18 0s12 6 18 0" class="wm-wave-line" />
          </pattern>
          <pattern id="wm-dots" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="0.9" class="wm-dot" />
          </pattern>
          <filter id="wm-rough" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" />
            <feDisplacementMap in="SourceGraphic" scale="5" />
          </filter>
          <filter id="wm-shadow" x="-10%" y="-10%" width="120%" height="120%">
            <feDropShadow dx="0" dy="6" stdDeviation="4" flood-color="#1d4e7a" flood-opacity="0.22" />
          </filter>
        </defs>
        <rect width="1000" height="1000" class="wm-sea" />
        <rect width="1000" height="1000" fill="url(#wm-wave)" class="wm-waves" />
        <g filter="url(#wm-shadow)">
          <g filter="url(#wm-rough)">
            {MAP_LAND.map((l) => <path d={l.d} class={`wm-land ${l.ward ? '' : 'wm-land-out'}`} style={WARD_FILL[l.ward] ? `fill:${WARD_FILL[l.ward]}` : ''} />)}
          </g>
        </g>
        <g filter="url(#wm-rough)" opacity="0.5">
          {MAP_LAND.map((l) => <path d={l.d} fill="url(#wm-dots)" />)}
        </g>
        <g class="wm-boat" aria-hidden="true">
          <path id="wm-route" d="M18 887 C 30 760, 70 620, 100 512" fill="none" />
          <g class="wm-boat-body">
            <g transform="scale(1.6)"><path d="M-16 0h32l-7 8h-18z" class="wm-ic-b" /><rect x="-10" y="-6" width="18" height="6" rx="1.5" class="wm-ic-b" /><rect x="-5" y="-11" width="9" height="5" rx="1.5" class="wm-ic-a" /><circle cx="-6" cy="-3" r="1" class="wm-ic-l" /><circle cx="-1" cy="-3" r="1" class="wm-ic-l" /><circle cx="4" cy="-3" r="1" class="wm-ic-l" /></g>
            <animateMotion dur="38s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#wm-route" /></animateMotion>
          </g>
        </g>
        <g class="wm-landmarks" aria-hidden="true">
          {MAP_LANDMARKS.map((l) => (
            <g transform={`translate(${l.x} ${l.y})`} class="wm-lm">
              <g transform="scale(1.5)" set:html={ICON[l.key] ?? ''} />
              <text y="30" class="wm-lm-name">{l.name}</text>
            </g>
          ))}
        </g>
        <g class="wm-areas">
          {MAP_AREAS.map((a) => (
            <a href={`/tags/${a.tag}/`} class="wm-area">
              <text x={a.x} y={a.y} class="wm-area-name">{a.tag}</text>
              <text x={a.x} y={a.y + 18} class="wm-area-ward">{a.ward}</text>
            </a>
          ))}
        </g>
        <g class="wm-pins" data-pins>
          {items.map((it, i) => (
            <a href={`/posts/${it.slug}/`} class={`wm-pin wm-pin-${it.kind}`} data-i={i} aria-label={`${it.title}（${it.kind === 'event' ? jpRange(it.start, it.end || undefined) : jpDate(it.start)}・${it.place}）`}>
              <title>{it.title}</title>
              <g transform={`translate(${it.x} ${it.y})`}><g class="wm-pin-scale">
              <circle r="22" cy="-30" class="wm-pin-pulse" />
              <g class="wm-pin-drop">
                <path d="M0 0l-7-10h14z" class="wm-pin-tail" />
                <circle cy="-30" r="22" class="wm-pin-ring" />
                <clipPath id={`wm-clip-${i}`}><circle cy="-30" r="18" /></clipPath>
                {it.img
                  ? <image href={it.img} x="-18" y="-48" width="36" height="36" preserveAspectRatio="xMidYMid slice" clip-path={`url(#wm-clip-${i})`} />
                  : <circle cy="-30" r="18" class="wm-pin-noimg" />}
                <g transform="translate(15 -47)" class="wm-pin-badge">
                  <rect x="-13" y="-9" width="26" height="18" rx="9" />
                  <text class="wm-pin-badge-t">{it.kind === 'event' ? `${Number(it.start.slice(5, 7))}/${Number(it.start.slice(8, 10))}` : 'NEW'}</text>
                </g>
                <text y="16" class="wm-pin-name">{it.short}</text>
              </g>
              </g></g>
            </a>
          ))}
        </g>
      </svg>

      <div class="wmap-guide" data-guide aria-live="polite">
        <div class="wmap-guide-bubble" data-guide-text>案内するわよ！</div>
        <img src="/images/expr-01-wave.png" alt="" class="wmap-guide-face" width="72" height="72" data-guide-face />
      </div>
    </div>

    <p class="wmap-pill" data-pill>📍 今日の湾岸</p>
    <div class="wmap-zoom">
      <button type="button" data-zoom="in" aria-label="拡大">＋</button>
      <button type="button" data-zoom="out" aria-label="縮小">－</button>
      <button type="button" data-zoom="reset" aria-label="全体を表示">⤢</button>
    </div>
    <div class="wmap-bar wmap-dock" role="toolbar" aria-label="表示するイベントの絞り込み">
      <button type="button" class="wmap-chip is-on" data-filter="all"><i aria-hidden="true">🗺️</i>すべて <b data-count="all"></b></button>
      <button type="button" class="wmap-chip" data-filter="now"><i aria-hidden="true">🎉</i>開催中 <b data-count="now"></b></button>
      <button type="button" class="wmap-chip" data-filter="week"><i aria-hidden="true">📅</i>7日以内 <b data-count="week"></b></button>
      <button type="button" class="wmap-chip" data-filter="free"><i aria-hidden="true">🆓</i>無料 <b data-count="free"></b></button>
      <button type="button" class="wmap-chip" data-filter="news"><i aria-hidden="true">📰</i>ニュース <b data-count="news"></b></button>
    </div>
    <p class="wmap-credit">地図：{MAP_SOURCE}をもとに作成</p>
  </div>

  <div class="wmap-card" data-card hidden>
    <button type="button" class="wmap-card-close" data-card-close aria-label="閉じる">×</button>
    <a data-card-link class="wmap-card-link">
      <img data-card-img alt="" loading="lazy" />
      <div>
        <p class="wmap-card-meta" data-card-meta></p>
        <p class="wmap-card-title" data-card-title></p>
        <p class="wmap-card-place" data-card-place></p>
        <span class="wmap-card-go">記事を読む →</span>
      </div>
    </a>
  </div>

  <ol class="wmap-list" data-list>
    {items.map((it, i) => (
      <li data-i={i} class={`wmap-li wmap-li-${it.kind}`}>
        <button type="button" data-goto={i} aria-label={`地図で${it.short}を見る`}>📍</button>
        <span class="wmap-li-date">{it.kind === 'event' ? jpRange(it.start, it.end || undefined) : `${jpDate(it.start)}のニュース`}</span>
        <a href={`/posts/${it.slug}/`}>{it.title}</a>
        <span class="wmap-li-place">{it.area && `${it.area}・`}{it.place}{it.kind === 'event' && (it.isFree ? '・無料' : '')}</span>
      </li>
    ))}
  </ol>
  <script type="application/json" data-wmap-data set:html={data} />
</section>

<script>
  type Item = { kind: 'event' | 'news'; slug: string; title: string; short: string; start: string; end: string; place: string; area: string; isFree: boolean; img: string; x: number; y: number };
  const WD = ['日', '月', '火', '水', '木', '金', '土'];
  const jp = (s: string) => { const [y, m, d] = s.split('-').map(Number); return `${m}月${d}日（${WD[new Date(Date.UTC(y, m - 1, d)).getUTCDay()]}）`; };
  const add = (s: string, n: number) => { const t = new Date(s + 'T00:00:00Z'); t.setUTCDate(t.getUTCDate() + n); return t.toISOString().slice(0, 10); };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-wmap]')) {
    const { today: buildDay, items } = JSON.parse(root.querySelector('[data-wmap-data]')!.textContent || '{}') as { today: string; items: Item[] };
    // 見ている日（ビルドした日より後に開かれたら、その日を「今日」にする）
    const nowJst = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
    const base = nowJst > buildDay ? nowJst : buildDay;
    let day = base;
    let filter = 'all';
    const pins = [...root.querySelectorAll<SVGAElement>('.wm-pin')];
    const lis = [...root.querySelectorAll<HTMLElement>('.wmap-li')];
    const label = root.querySelector<HTMLOutputElement>('[data-day-label]')!;
    const range = root.querySelector<HTMLInputElement>('#wmap-day')!;
    const guide = root.querySelector<HTMLElement>('[data-guide]')!;
    const guideText = root.querySelector<HTMLElement>('[data-guide-text]')!;
    const guideFace = root.querySelector<HTMLImageElement>('[data-guide-face]')!;
    const card = root.querySelector<HTMLElement>('[data-card]')!;
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const pill = root.querySelector<HTMLElement>('[data-pill]')!;

    const isOn = (it: Item) => it.kind === 'news' ? it.start <= day : it.start <= day && day <= (it.end || add(it.start, 60));
    const isSoon = (it: Item) => it.kind === 'event' && it.start > day && it.start <= add(day, 7);
    const visible = (it: Item) => {
      if (it.kind === 'event' && (it.end || add(it.start, 60)) < day) return false;
      if (it.kind === 'news' && it.start > day) return false;
      switch (filter) {
        case 'now': return it.kind === 'event' && isOn(it);
        case 'week': return it.kind === 'event' && (isOn(it) || isSoon(it));
        case 'free': return it.kind === 'event' && it.isFree;
        case 'news': return it.kind === 'news';
        default: return true;
      }
    };
    const counts = () => {
      const c: Record<string, number> = { all: 0, now: 0, week: 0, free: 0, news: 0 };
      for (const it of items) {
        if (it.kind === 'event' && (it.end || add(it.start, 60)) < day) continue;
        c.all++;
        if (it.kind === 'event' && isOn(it)) c.now++;
        if (it.kind === 'event' && (isOn(it) || isSoon(it))) c.week++;
        if (it.kind === 'event' && it.isFree) c.free++;
        if (it.kind === 'news') c.news++;
      }
      for (const [k, v] of Object.entries(c)) { const b = root.querySelector(`[data-count="${k}"]`); if (b) b.textContent = String(v); }
    };
    const render = () => {
      items.forEach((it, i) => {
        const show = visible(it);
        pins[i].classList.toggle('is-hidden', !show);
        pins[i].classList.toggle('is-now', show && it.kind === 'event' && isOn(it));
        pins[i].classList.toggle('is-soon', show && isSoon(it));
        lis[i].hidden = !show;
      });
      label.textContent = day === base ? `${jp(day)}・今日` : jp(day);
      pill.textContent = `📍 ${day === base ? '今日' : jp(day)}の湾岸・${items.filter((it) => visible(it)).length}件`;
      counts();
    };

    // ── ハッカー子の案内 ──
    const FACES = ['/images/expr-01-wave.png', '/images/expr-04-cheer.png', '/images/expr-05-smug.png', '/images/expr-07-gasp.png'];
    let tourIdx = -1; let tourTimer = 0;
    const moveGuide = (i: number, say?: string) => {
      const it = items[i];
      guide.style.left = `${it.x / 10}%`;
      guide.style.top = `${it.y / 10}%`;
      guide.classList.remove('is-hop'); void guide.offsetWidth; guide.classList.add('is-hop');
      guide.classList.toggle('is-left', it.x > (stage.clientWidth < 520 ? 480 : 620));
      guideFace.src = FACES[i % FACES.length];
      const when = it.kind === 'news' ? 'のニュース' : isOn(it) ? 'は開催中！' : `は${jp(it.start)}から`;
      guideText.textContent = say ?? `${it.area || it.place}の「${it.short}」${when}`;
      pins.forEach((p, k) => p.classList.toggle('is-focus', k === i));
    };
    const tourList = () => items.map((it, i) => ({ it, i })).filter(({ it }) => visible(it)).sort((a, b) => Number(isOn(b.it)) - Number(isOn(a.it)) || a.it.start.localeCompare(b.it.start));
    const step = () => {
      const list = tourList();
      if (!list.length) { guideText.textContent = 'この条件のイベントは無いわ。日付か絞り込みを変えてみて'; return; }
      tourIdx = (tourIdx + 1) % list.length;
      moveGuide(list[tourIdx].i);
    };
    const startTour = () => { clearInterval(tourTimer); if (!reduce) tourTimer = window.setInterval(step, 4800); };
    guide.addEventListener('click', () => { step(); startTour(); });

    // ── カード ──
    const open = (i: number) => {
      const it = items[i];
      card.hidden = false;
      (card.querySelector('[data-card-link]') as HTMLAnchorElement).href = `/posts/${it.slug}/`;
      const img = card.querySelector<HTMLImageElement>('[data-card-img]')!; img.src = it.img; img.hidden = !it.img;
      card.querySelector('[data-card-meta]')!.textContent = it.kind === 'news' ? `${jp(it.start)}のニュース` : `${isOn(it) ? '開催中・' : ''}${jp(it.start)}${it.end && it.end !== it.start ? `〜${jp(it.end)}` : ''}`;
      card.querySelector('[data-card-title]')!.textContent = it.title;
      card.querySelector('[data-card-place]')!.textContent = `${it.place}${it.kind === 'event' ? (it.isFree ? '・無料' : '・料金は記事で') : ''}`;
      moveGuide(i, it.kind === 'event' && isOn(it) ? 'ここ！いま開催中よ' : 'ここよ！');
      clearInterval(tourTimer);
    };
    pins.forEach((p, i) => p.addEventListener('click', (e) => { e.preventDefault(); open(i); }));
    root.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => { open(Number(b.dataset.goto)); stage.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }); }));
    root.querySelector('[data-card-close]')!.addEventListener('click', () => { card.hidden = true; startTour(); });

    // ── 絞り込み・日付 ──
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
      filter = b.dataset.filter!;
      root.querySelectorAll('[data-filter]').forEach((x) => x.classList.toggle('is-on', x === b));
      render(); tourIdx = -1; step(); startTour();
    }));
    range.addEventListener('input', () => { day = add(base, Number(range.value)); render(); });
    range.addEventListener('change', () => { tourIdx = -1; step(); });
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    let playTimer = 0;
    play.addEventListener('click', () => {
      if (playTimer) { clearInterval(playTimer); playTimer = 0; play.textContent = '▶ 90日を再生'; play.setAttribute('aria-pressed', 'false'); return; }
      play.textContent = '■ 止める'; play.setAttribute('aria-pressed', 'true');
      if (Number(range.value) >= 90) range.value = '0';
      playTimer = window.setInterval(() => {
        const v = Number(range.value) + 1; range.value = String(v); day = add(base, v); render();
        if (v % 6 === 0) { tourIdx = -1; step(); }
        if (v >= 90) { clearInterval(playTimer); playTimer = 0; play.textContent = '▶ 90日を再生'; play.setAttribute('aria-pressed', 'false'); }
      }, reduce ? 400 : 180);
    });

    // ── 拡大・移動（ドラッグ・ピンチ・ボタン） ──
    let z = 1, tx = 0, ty = 0;
    const clamp = () => { const w = stage.clientWidth, h = stage.clientHeight; tx = Math.min(0, Math.max(w - w * z, tx)); ty = Math.min(0, Math.max(h - h * z, ty)); };
    const apply = () => { clamp(); canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${z})`; root.style.setProperty('--wm-z', String(z)); root.classList.toggle('is-zoomed', z >= 2.5); };
    const zoomAt = (nz: number, cx: number, cy: number) => { nz = Math.min(4, Math.max(1, nz)); tx = cx - ((cx - tx) * nz) / z; ty = cy - ((cy - ty) * nz) / z; z = nz; apply(); };
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => {
      const r = stage.getBoundingClientRect();
      if (b.dataset.zoom === 'reset') { z = 1; tx = 0; ty = 0; apply(); return; }
      zoomAt(z * (b.dataset.zoom === 'in' ? 1.5 : 1 / 1.5), r.width / 2, r.height / 2);
    }));
    const pts = new Map<number, { x: number; y: number }>();
    let last: { x: number; y: number; d: number } | null = null; let moved = false;
    stage.addEventListener('pointerdown', (e) => { pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); moved = false; last = null; });
    stage.addEventListener('pointermove', (e) => {
      if (!pts.has(e.pointerId)) return;
      const prev = pts.get(e.pointerId)!; pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size === 1 && z > 1) { tx += e.clientX - prev.x; ty += e.clientY - prev.y; if (Math.abs(e.clientX - prev.x) + Math.abs(e.clientY - prev.y) > 2) { moved = true; stage.setPointerCapture(e.pointerId); } apply(); }
      if (pts.size === 2) {
        const [a, b] = [...pts.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y); const r = stage.getBoundingClientRect();
        const c = { x: (a.x + b.x) / 2 - r.left, y: (a.y + b.y) / 2 - r.top };
        if (last) zoomAt(z * (d / last.d), c.x, c.y);
        last = { ...c, d }; moved = true;
      }
    });
    const up = (e: PointerEvent) => { pts.delete(e.pointerId); if (pts.size < 2) last = null; };
    stage.addEventListener('pointerup', up); stage.addEventListener('pointercancel', up);
    stage.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    stage.addEventListener('wheel', (e) => { if (!e.ctrlKey && z === 1) return; e.preventDefault(); const r = stage.getBoundingClientRect(); zoomAt(z * (e.deltaY < 0 ? 1.15 : 1 / 1.15), e.clientX - r.left, e.clientY - r.top); }, { passive: false });

    render();
    // スマホは最初から湾岸の真ん中（豊洲・晴海・有明）に寄せる。全体は ⤢ で戻せる
    const fitStart = () => { if (stage.clientWidth < 600) { z = 1; tx = 0; ty = 0; const w = stage.clientWidth; zoomAt(1.7, w * 0.5, w * 0.44); } };
    fitStart();
    // 画面に入ってから案内を始める（ピンは上から落ちてくる）
    new IntersectionObserver((ents, ob) => { if (ents.some((x) => x.isIntersecting)) { root.classList.add('is-in'); setTimeout(() => { step(); startTour(); }, reduce ? 0 : 900); ob.disconnect(); } }, { threshold: 0.25 }).observe(stage);
  }
</script>

