---
/**
 * 湾岸エリアイベントマップ（2026-11-02 作成・11-03 利用者の 7 件の指摘で作り直し）。湾岸ライフの一覧と /wangan-map/ に置く。
 * - 地図: イラスト調の SVG。陸の形は国土地理院の地図から取った海岸線（新橋・銀座〜有明・青海。辰巳は外した）
 * - ピン: 記事の `event:` から毎朝のビルドで入れ替わる。触れる・押すと地図の上に小窓が出る
 * - 期間: すべて／今日／今週／来週／今月／来月／今年 から選ぶ（日付の帯はやめた）
 * - 動く絵: 船・屋形船・ゆりかもめ・かもめ・雲の影。ハッカー子が開催中のものから案内する
 * 動きは prefers-reduced-motion で止める。
 */
import { MAP_W, MAP_H, MAP_LAND, MAP_AREAS, MAP_LANDMARKS, MAP_SOURCE, MAP_STATIONS, MAP_YURIKAMOME, MAP_REF_AREAS, MAP_SUBWAYS, MAP_WIDE, MAP_PAN, MAP_OUTER_STATIONS, MAP_OUTER_PLACES, MAP_OUTER_LINES, MAP_OUTER_LINE_LABELS, MAP_OUTER_SPOTS, MAP_OUTER_STATION_NAMED, mapItems } from '../lib/wangan-map';
import { todayJst, jpDate, jpRange } from '../lib/wangan';
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'posts'>[]; headingLevel?: 'h1' | 'h2'; title?: string; lead?: boolean; bake?: boolean }
// bake: 湾岸の外の路線と札を部品で描く（画像に焼く作業用ページ /wangan-map-bake/ だけ）。普段は焼いた画像を置く（2026-11-07・重さ対策）
const { posts, headingLevel = 'h2', title = '湾岸エリアイベントマップ', lead = true, bake = false } = Astro.props;
const today = todayJst();
const items = mapItems(posts, today);
const H = headingLevel;
const WARD_FILL: Record<string, string> = { 中央区: 'var(--wm-land-chuo)', 江東区: 'var(--wm-land-koto)' };

// ゆりかもめの線（駅を通るなめらかな線）
const rail = MAP_YURIKAMOME.length > 1
  ? MAP_YURIKAMOME.reduce((d, s, i, a) => {
      if (i === 0) return `M${s.x},${s.y}`;
      const p = a[i - 1];
      const mx = (p.x + s.x) / 2, my = (p.y + s.y) / 2;
      return `${d} Q${p.x},${p.y} ${mx},${my}`;
    }, '') + ` T${MAP_YURIKAMOME.at(-1)!.x},${MAP_YURIKAMOME.at(-1)!.y}`
  : '';
const smooth = (pts: { x: number; y: number }[]) => pts.reduce((d, s, i, a) => {
  if (i === 0) return `M${s.x},${s.y}`;
  const p = a[i - 1];
  return `${d} Q${p.x},${p.y} ${(p.x + s.x) / 2},${(p.y + s.y) / 2}`;
}, '') + ` T${pts.at(-1)!.x},${pts.at(-1)!.y}`;
// 地下鉄は駅を必ず通るよう、駅と駅を結ぶ（曲線にすると駅を外れる）
const straight = (pts: { x: number; y: number }[]) => pts.map((p, i) => `${i ? 'L' : 'M'}${p.x},${p.y}`).join(' ');
// 線の名前は、利用者が挙げた区間（勝どき〜月島・月島〜豊洲）の真ん中に置く
const midOf = (a?: { x: number; y: number }, b?: { x: number; y: number }) => (a && b ? { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 } : null);
const at = (k: string) => MAP_STATIONS.find((s) => s.key === k);
const tsuki = at('月島駅'), kachi = at('勝どき駅'), toyosuSt = at('豊洲駅'), takeshiba = at('竹芝駅'), hinode = at('日の出駅');
const SUBWAY_LABEL: Record<string, { x: number; y: number } | null> = { oedo: midOf(kachi, tsuki), yurakucho: midOf(tsuki, toyosuSt) };
const yuriLabel = midOf(takeshiba, hinode);

// 目印の絵（ 0,0 が建物の足元。横 ±30 ほど）
const ICON: Record<string, string> = {
  // 晴海トリトン: 3 本の高層棟（ガラスの縦の帯）と低層の土台
  triton: `<rect x="-30" y="-6" width="60" height="10" rx="2" class="b"/>
    <path d="M-24 -6V-52h14V-6" class="g"/><path d="M-7 -6V-62h14V-6" class="g"/><path d="M10 -6V-46h14V-6" class="g"/>
    <path d="M-20 -48v40M-14 -48v40M-3 -58v50M3 -58v50M14 -42v34M20 -42v34" class="l2"/>
    <path d="M-24 -52h14M-7 -62h14M10 -46h14" class="l"/>`,
  // 晴海フラッグ: 色違いの中層棟が並び、真ん中に 2 本のタワー。旗
  'harumi-flag': `<rect x="-34" y="-20" width="16" height="22" class="c1"/><rect x="-16" y="-26" width="14" height="28" class="c2"/>
    <rect x="18" y="-22" width="16" height="24" class="c3"/><path d="M0 2V-56h8V2M10 2V-50h7V2" class="g"/>
    <path d="M-30 -14h8M-30 -8h8M-12 -20h6M-12 -14h6M22 -16h8M22 -10h8" class="l2"/>
    <path d="M4 -56v-12" class="l"/><path d="M4 -68l12 4-12 4z" class="a"/><rect x="-36" y="2" width="72" height="4" rx="2" class="gr"/>`,
  // 豊洲市場: 長い低い屋根の棟が 2 つ
  market: `<path d="M-34 0h30v-12l-15-6-15 6z" class="b"/><path d="M2 0h32v-12l-16-7-16 7z" class="b"/>
    <path d="M-30 -6h22M6 -6h24" class="l2"/><path d="M-20 -26c4-5 10-5 14 0-4 5-10 5-14 0z" class="a"/><path d="M-6 -26l5-3v6z" class="a"/>`,
  // ららぽーと豊洲: ショッピングモール（2026-11-03 利用者「アイコンが船なのはおかしい／ショッピングモールです」）。横長の建物・ガラスの入口・紙袋
  lalaport: `<rect x="-34" y="-22" width="68" height="24" rx="3" class="b"/><path d="M-34 -14h68" class="l2"/>
    <rect x="-8" y="-12" width="16" height="14" rx="1.5" class="g"/><path d="M0 -12v14" class="l2"/>
    <rect x="-28" y="-10" width="12" height="7" rx="1" class="g"/><rect x="16" y="-10" width="12" height="7" rx="1" class="g"/>
    <path d="M-26 -22l4-8h44l4 8z" class="a"/>
    <path d="M18 -42h14l2 14h-18z" class="c2"/><path d="M21 -42a4 4 0 0 1 8 0" class="l"/>`,
  'ariake-arena': `<path d="M-32 2a32 24 0 0 1 64 0z" class="b"/><path d="M-22 2a22 15 0 0 1 44 0" class="l2"/><path d="M-32 2h64" class="l"/>`,
  'ariake-garden': `<rect x="-30" y="-12" width="60" height="14" rx="3" class="b"/><rect x="-8" y="-34" width="16" height="22" class="g"/>
    <circle cx="-20" cy="-16" r="8" class="t"/><circle cx="22" cy="-17" r="9" class="t"/>`,
  // 東京ビッグサイト: 逆さのピラミッドが 4 つ
  bigsight: `<rect x="-30" y="-6" width="60" height="8" class="b"/><path d="M-30 -6l6-10V-26h-10zM-14 -26h14l-4 10v10h-6v-10z" class="g"/>
    <path d="M4 -26h14l-4 10v10h-6v-10zM22 -26h12l-4 10v10h-4z" class="g"/>`,
  diversity: `<rect x="-30" y="-24" width="60" height="26" rx="3" class="b"/><path d="M-30 -14h60" class="l2"/><rect x="-6" y="-34" width="12" height="10" class="a"/>`,
  // 月島もんじゃストリート: のれんの店が並ぶ
  monja: `<rect x="-30" y="-16" width="20" height="18" class="b"/><rect x="-8" y="-18" width="18" height="20" class="b"/><rect x="12" y="-15" width="18" height="17" class="b"/>
    <path d="M-30 -16h20v6h-20zM-8 -18h18v6h-18zM12 -15h18v6h-18z" class="a"/><ellipse cx="0" cy="10" rx="9" ry="3" class="c3"/>`,
  bousai: `<circle cx="-14" cy="-12" r="11" class="t"/><circle cx="8" cy="-16" r="13" class="t"/><circle cx="24" cy="-8" r="8" class="t"/><rect x="-2" y="-6" width="3" height="8" class="b"/>`,
};
const data = JSON.stringify({ today, items, pan: MAP_PAN });
const ratio = (MAP_H / MAP_W).toFixed(4);
---

<noscript><style>.wmap .wmap-canvas { opacity: 1 !important; }</style></noscript>
<div class="wmap" role="region" aria-labelledby="wmap-title" data-wmap style={`--wm-ratio:${ratio}`}>
  <div class="wmap-head">
    <H id="wmap-title" class="wmap-title">{title}<span>（{jpDate(today)}時点）</span></H>
    {lead && <p class="wmap-lead">晴海・勝どき・月島・築地・豊洲・有明・お台場（中央区・江東区）で、<strong>いま開いているイベントとこれから始まるイベント</strong>を地図に置いた。ピンに触れると、その場で日付・会場・料金が出る。下の帯で「今週」「来月」のように期間を選べるわよ。</p>}
  </div>

  <div class="wmap-stage" data-stage>
    <div class="wmap-canvas" data-canvas>
      {!bake && (
        <div class="wmap-base" aria-hidden="true" style={`left:${(MAP_PAN.x / MAP_W) * 100}%;top:${(MAP_PAN.y / MAP_H) * 100}%;width:${(MAP_PAN.w / MAP_W) * 100}%;height:${(MAP_PAN.h / MAP_H) * 100}%`}>
          <img class="wmap-base-lo" src="/images/wangan-map/base-lo.webp" alt="" decoding="async" fetchpriority="high" />
          <div class="wmap-tiles" data-tiles></div>
        </div>
      )}
      {/* 2026-11-08 利用者が「動く絵を別の層にする」を選んだ: 船・魚・雲・電車を、ピンや文字の SVG とは別の SVG に分けた。
          同じ SVG の中で動いていると、1 つ動くたびにピンと文字まで描き直していた（iPhone 相当で、何もしない 3 秒のうち 671ms がこれ）。
          この層だけが描き直され、上のピン・文字の層は止まったまま */}
      {/* 2026-11-08 利用者が「動く絵を別の層にする」を選んだ。船・魚・雲・電車は、SVG の中で動かす作り（SMIL）だと 1 つ動くたびに描き直しになる
          （iPhone 相当で、何もしない 3 秒のうち約 600ms）。1 つずつ小さな絵にして、ブラウザの「位置だけ動かす」仕組み（CSS の transform・offset-path）で動かす。
          絵は一度描いたら描き直さない。見た目と動き（道筋・往復・揺れ・向きの反転）は元のまま。地図の 1 単位 = 1px の箱を、地図の幅に合わせて縮める */}
      <div class="wmap-movers wm-anim" data-movers aria-hidden="true" style={`height:${MAP_H}px`}>
        {/* 水上バス・屋形船: 海の上だけを通る道筋を往復（2026-11-03 利用者「船のアイコンが陸の上を走っているのでNG」） */}
        <div class="wm-mv wm-mv-boat" data-path="M 250 1290 C 222 1190, 262 1110, 236 1010 S 258 860, 242 780 S 254 660, 245 610" data-go="20"><div class="wm-flip" style="--dur: 40s;"><div class="wm-bob"><div class="wm-rock"><svg class="wm-mv-art" viewBox="-60 -30 120 60" width="120" height="60" aria-hidden="true"><defs><filter id="wm-veh" x="-20%" y="-30%" width="140%" height="170%"><feDropShadow dx="0" dy="2.2" stdDeviation="1.4" flood-color="#1d3a5a" flood-opacity="0.28" /></filter></defs><g transform="scale(1.15)" filter="url(#wm-veh)">
            {/* 水上バス（2026-11-04 利用者「電車と船をもう少しイラスト調ではありながらもリアリティがあるように」）: 紺の船体・白い客室・窓の列・航跡 */}
            <path d="M-34 1 q-8 2 -16 0 M-34 5 q-10 4 -20 3" class="wake" />
            <path d="M-28 -1 H22 Q30 -1 33 1 Q30 7 22 8 H-24 Q-28 7 -28 -1Z" class="hull" />
            <path d="M-27 1.6 H30" class="hull-band" />
            <path d="M-21 -1 V-9 Q-21 -11 -19 -11 H12 Q18 -11 21 -1Z" class="cabin" />
            {[-17, -11, -5, 1, 7].map((x) => <rect x={x} y="-8.6" width="4.4" height="4.2" rx="0.8" class="glass" />)}
            <path d="M14 -8.4 L19 -2.6 H14Z" class="glass" />
            <rect x="-14" y="-15.5" width="16" height="4.5" rx="1.5" class="cabin" />
            <path d="M-10 -15.5 V-20 M-10 -19 h5" class="mast" />
          </g></svg></div></div></div></div>
        <div class="wm-mv wm-mv-boat" data-path="M 630 628 Q 590 665, 540 700 T 440 752" data-go="27.5"><div class="wm-flip" style="--dur: 55s;"><div class="wm-bob"><div class="wm-rock"><svg class="wm-mv-art" viewBox="-60 -30 120 60" width="120" height="60" aria-hidden="true"><defs><filter id="wm-veh" x="-20%" y="-30%" width="140%" height="170%"><feDropShadow dx="0" dy="2.2" stdDeviation="1.4" flood-color="#1d3a5a" flood-opacity="0.28" /></filter></defs><g transform="scale(1.15)" filter="url(#wm-veh)">
            {/* 屋形船: 木の船体・障子の窓・瓦の屋根・赤い提灯 */}
            <path d="M-32 2 q-8 2 -14 0" class="wake" />
            <path d="M-28 1 H24 Q31 0 34 -3 Q32 6 24 8 H-24 Q-28 7 -28 1Z" class="wood" />
            <path d="M-27 3.4 H29" class="wood-line" />
            <rect x="-22" y="-9" width="42" height="10" rx="1" class="shoji" />
            {[-16, -10, -4, 2, 8, 14].map((x) => <path d={`M${x} -9 V1`} class="shoji-line" />)}
            <path d="M-22 -4 H20" class="shoji-line" />
            <path d="M-27 -9 Q-1 -12 25 -9 L21 -15 Q-1 -17 -23 -15Z" class="roof" />
            <path d="M-24 -9 H22" class="eave" />
            {[-18, -9, 0, 9, 18].map((x) => <g><ellipse cx={x} cy="-6.6" rx="1.9" ry="2.4" class="chochin" /><circle cx={x} cy="-6.6" r="4" class="chochin-glow" /></g>)}
          </g></svg></div></div></div></div>
        {/* 魚: 陸から 16 以上離れた横 80 の帯を往復（2026-11-07 利用者「海の箇所には、魚が泳いでいるようなイラストも追加して」） */}
        {[
          { x: 200, y: 640, c: '#ff9a5a', d: 16 }, { x: 480, y: 700, c: '#4fb3bf', d: 19 }, { x: 300, y: 780, c: '#f6c453', d: 14 },
          { x: 140, y: 960, c: '#ff8fa3', d: 17 }, { x: 200, y: 1160, c: '#4fb3bf', d: 15 }, { x: 860, y: 1280, c: '#ff9a5a', d: 18 },
        ].map((f, i) => (
          <div class="wm-fish-mv" style={`left:${f.x}px;top:${f.y}px;--dur:${f.d}s;--delay:-${i * 3}s`}><div class="wm-fish-swim"><div class="wm-flip"><svg class="wm-mv-art" viewBox="-20 -12 40 24" width="40" height="24" aria-hidden="true"><g class="wm-fish-body" style={`--fish:${f.c}`}>
                    <path d="M-7 0 L-12 -4.5 L-11 0 L-12 4.5Z" class="fish-tail" />
                    <ellipse cx="0" cy="0" rx="8" ry="4.2" class="fish-fill" />
                    <path d="M-1 -4 Q1.5 -7 4 -3.6" class="fish-fin" />
                    <circle cx="4.4" cy="-0.9" r="1" class="fish-eye" />
                  </g></svg></div></div></div>
        ))}
        <div class="wm-cloud wm-cloud1"></div>
        <div class="wm-cloud wm-cloud2"></div>
        {/* 地下鉄（大江戸線・有楽町線）とゆりかもめ: 線路の上を往復（2026-11-07 利用者「大江戸線や有楽町線も電車を動かすようにして」） */}
        {MAP_SUBWAYS.map((l, i) => (
          <div class="wm-mv wm-mv-train" data-path={straight(l.pts)} data-go={l.key === 'oedo' ? 15 : 13} data-delay={-i * 7} data-rot="1"><svg class="wm-mv-art" viewBox="-60 -30 120 60" width="120" height="60" aria-hidden="true"><defs><filter id="wm-veh" x="-20%" y="-30%" width="140%" height="170%"><feDropShadow dx="0" dy="2.2" stdDeviation="1.4" flood-color="#1d3a5a" flood-opacity="0.28" /></filter></defs><g class="wm-train wm-subtrain"><g transform="scale(1.05)" filter="url(#wm-veh)">
              {[-27, -9].map((x) => <g><rect x={x} y="-5.5" width="17" height="11" rx="2" class="car sub-car" /><rect x={x + 2} y="-3.6" width="13" height="3.8" rx="0.8" class="car-win" /><path d={`M${x + 0.6} 2.4 H${x + 16.4}`} class="car-band" style={`stroke:${l.color}`} /></g>)}
              <path d="M9 -5.5 H22 Q28 -5.5 29 0 Q28 5.5 22 5.5 H9Z" class="car sub-car" />
              <path d="M11 -3.6 H22 Q25.8 -3.6 26.6 -0.6 L11 -0.6Z" class="car-win" />
              <path d="M9.6 2.4 H27.8" class="car-band" style={`stroke:${l.color}`} />
              <circle cx="26.8" cy="3.2" r="0.9" class="car-lamp" />
              <path d="M-10.4 0 H-9.4 M8 0 H9" class="car-joint" />
            </g></g></svg></div>
        ))}
        {rail && <div class="wm-mv wm-mv-train" data-path={rail} data-go="17" data-rot="1"><svg class="wm-mv-art" viewBox="-60 -30 120 60" width="120" height="60" aria-hidden="true"><defs><filter id="wm-veh" x="-20%" y="-30%" width="140%" height="170%"><feDropShadow dx="0" dy="2.2" stdDeviation="1.4" flood-color="#1d3a5a" flood-opacity="0.28" /></filter></defs><g class="wm-train"><g transform="scale(1.15)" filter="url(#wm-veh)">
              {/* ゆりかもめ: 白い車体・青い帯・黒い窓・丸い先頭 */}
              {[-27, -9].map((x) => <g><rect x={x} y="-6" width="17" height="12" rx="2.4" class="car" /><rect x={x + 2} y="-4" width="13" height="4.2" rx="1" class="car-win" /><path d={`M${x + 0.6} 2.6 H${x + 16.4}`} class="car-band" /></g>)}
              <path d="M9 -6 H22 Q29 -6 30 0 Q29 6 22 6 H9Z" class="car" />
              <path d="M11 -4 H22 Q26.5 -4 27.4 -0.6 L11 -0.6Z" class="car-win" />
              <path d="M9.6 2.6 H28.6" class="car-band" />
              <circle cx="27.6" cy="3.6" r="0.9" class="car-lamp" />
              <path d="M-10.4 0 H-9.4 M8 0 H9" class="car-joint" />
            </g></g></svg></div>}
      </div>
      <svg class="wmap-svg" viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-labelledby="wmap-svg-title">
        <title id="wmap-svg-title">湾岸エリア（中央区・江東区）のイベントマップ。新橋・銀座・築地から晴海・豊洲・有明・お台場まで</title>
        <defs>
          <pattern id="wm-wave" width="60" height="22" patternUnits="userSpaceOnUse"><path d="M2 14c6-6 12-6 18 0s12 6 18 0" class="wm-wave-line" /></pattern>
          <pattern id="wm-dots" width="10" height="10" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="0.9" class="wm-dot" /></pattern>
          <filter id="wm-rough" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" /><feDisplacementMap in="SourceGraphic" scale="5" /></filter>
          <filter id="wm-shadow" x="-10%" y="-10%" width="120%" height="120%"><feDropShadow dx="0" dy="6" stdDeviation="4" flood-color="#1d4e7a" flood-opacity="0.2" /></filter>
        </defs>
        {/* 2026-11-07 利用者「まだ移動が遅すぎる／根本的に設計が間違っている／ディズニーのアプリを見習って」:
            動かない絵（海・陸・路線）は、手描きの揺れ・影・ドットのフィルターを毎回その場で計算していて、動かすたびに描き直しになっていた。
            ここは作業用ページ（bake）でだけ描き、scripts/wangan-map/render-base.cjs で画像（地図アプリと同じタイル）に焼く。本番の地図は画像を滑らせるだけ */}
        {bake && (<g class="wm-base">
        {/* 海と外側の陸は、縮小したときに見える広さまで描く（2026-11-03 利用者「－を押した時はもっと広範囲の地図を表示して」） */}
        <rect x={MAP_PAN.x} y={MAP_PAN.y} width={MAP_PAN.w} height={MAP_PAN.h} class="wm-sea" />
        <rect x={MAP_PAN.x} y={MAP_PAN.y} width={MAP_PAN.w} height={MAP_PAN.h} fill="url(#wm-wave)" class="wm-waves" />
        <clipPath id="wm-outside"><path clip-rule="evenodd" d={`M${MAP_PAN.x},${MAP_PAN.y}h${MAP_PAN.w}v${MAP_PAN.h}h${-MAP_PAN.w}Z M10,10V${MAP_H - 10}H${MAP_W - 10}V10Z`} /></clipPath>
        {/* 外側の陸も本体と同じ作り（手描きの揺れ・影・ドット・縁の色）にする（2026-11-04 利用者「元々のマップは地形にドットが入っているけど、新しく追加したマップにはドットが入っていないのでデザインが浮いている」） */}
        <g clip-path="url(#wm-outside)" class="wm-wide" aria-hidden="true">
          <g filter="url(#wm-shadow)"><g filter="url(#wm-rough)">{MAP_WIDE.land.map((d) => <path d={d} class="wm-land" fill-rule="evenodd" />)}</g></g>
          <g filter="url(#wm-rough)" opacity="0.45">{MAP_WIDE.land.map((d) => <path d={d} fill="url(#wm-dots)" fill-rule="evenodd" />)}</g>
        </g>
        {/* 本体の陸は、地図の枠の線（切り取った辺）に縁取りが出ないよう、少し内側で切る */}
        <mask id="wm-feather" maskUnits="userSpaceOnUse" x="0" y="0" width={MAP_W} height={MAP_H}><rect x="60" y="60" width={MAP_W - 120} height={MAP_H - 120} fill="#fff" filter="url(#wm-feather-blur)" /></mask>
        <filter id="wm-feather-blur" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="28" /></filter>
        <clipPath id="wm-core"><rect x="5" y="5" width={MAP_W - 10} height={MAP_H - 10} /></clipPath>
        <g clip-path="url(#wm-core)">
        <g filter="url(#wm-shadow)"><g filter="url(#wm-rough)">
          {MAP_LAND.map((l) => <path d={l.d} class="wm-land" />)}
        </g></g>
        {/* 区の色分けは上に重ね、地図の端に向かってぼかす（外側の陸と同じ地の色につながり、境目が出ない） */}
        <g mask="url(#wm-feather)" filter="url(#wm-rough)">{MAP_LAND.filter((l) => WARD_FILL[l.ward]).map((l) => <path d={l.d} class="wm-ward" style={`fill:${WARD_FILL[l.ward]}`} />)}</g>
        <g filter="url(#wm-rough)" opacity="0.45">{MAP_LAND.map((l) => <path d={l.d} fill="url(#wm-dots)" />)}</g>
        </g>
        </g>)}


        {/* 鉄道の路線（停車駅を順につなぐ・路線の色）。湾岸の線より下に敷く */}
        {bake && (
        <g class="wm-base wm-rails-outer" aria-hidden="true">
          {MAP_OUTER_LINES.map((l) => <polyline points={l.pts.map((q) => `${q.x},${q.y}`).join(' ')} class="wm-rl-bed" />)}
          {MAP_OUTER_LINES.map((l) => <polyline points={l.pts.map((q) => `${q.x},${q.y}`).join(' ')} class="wm-rl" style={`stroke:${l.colour}`} />)}
        </g>
        )}
        {/* 地下鉄（都営大江戸線・東京メトロ有楽町線） */}
        <g class="wm-subways" aria-hidden="true">
          {/* 線は画像に焼く（bake のときだけ描く）。電車が走る道筋（id 付き）は見えない線で残す */}
          {bake && <g class="wm-base">{MAP_SUBWAYS.map((l) => <path d={straight(l.pts)} class="wm-sub-bed" />)}{MAP_SUBWAYS.map((l) => <path d={straight(l.pts)} class="wm-sub-line" style={`stroke:${l.color}`} />)}</g>}
        </g>

        {/* ゆりかもめ */}
        {rail && (
          <g class="wm-rail" aria-hidden="true">
            {bake && <g class="wm-base"><path d={rail} class="wm-rail-bed" /><path d={rail} class="wm-rail-line" /></g>}
          </g>
        )}

        {/* 地図の外側の地名と駅（縮小したときに見える。湾岸の外なのでピンや地区の札は出さない・2026-11-07） */}
        {bake ? (
        <g class="wm-outer" aria-hidden="true">
          {MAP_OUTER_LINE_LABELS.map((l) => <g transform={`translate(${l.x} ${l.y})`} class="wm-rl-lb"><g class="wm-st-in"><rect x={-(l.name.length * 5.6 + 8)} y="-9" width={l.name.length * 11.2 + 16} height="18" rx="9" style={`fill:${l.colour}`} /><text y="4">{l.name}</text></g></g>)}
          {MAP_OUTER_SPOTS.map((sp) => <g transform={`translate(${sp.x} ${sp.y})`} class="wm-spot"><g class="wm-st-in"><circle r="13" class="wm-spot-bg" /><text y="5" class="wm-spot-ico">{sp.icon}</text><text y="28" class="wm-spot-name">{sp.name}</text></g></g>)}
          {MAP_OUTER_PLACES.map((a) => <g transform={`translate(${a.x} ${a.y})`} class="wm-outer-pl"><text class="wm-outer-pl-name">{a.name}</text></g>)}
          {MAP_OUTER_STATIONS.map((s) => (
            <g transform={`translate(${s.x} ${s.y})`} class="wm-outer-st"><g class="wm-st-in"><circle r="4.5" class="wm-outer-st-dot" />{MAP_OUTER_STATION_NAMED.has(s.name) && <text x="7" y="4" class="wm-outer-st-name">{s.name}駅</text>}</g></g>
          ))}
        </g>
        ) : (
          <>
            <image class="wm-outer-labels wm-ol-far" data-src="/images/wangan-map/outer-labels-far.png" x={MAP_PAN.x} y={MAP_PAN.y} width={MAP_PAN.w} height={MAP_PAN.h} preserveAspectRatio="none" aria-hidden="true" />
            <image class="wm-outer-labels wm-ol-mid" data-src="/images/wangan-map/outer-labels-mid.png" x={MAP_PAN.x} y={MAP_PAN.y} width={MAP_PAN.w} height={MAP_PAN.h} preserveAspectRatio="none" aria-hidden="true" />
          </>
        )}

        <g class="wm-landmarks" aria-hidden="true">
          {MAP_LANDMARKS.map((l) => (
            <g transform={`translate(${l.x} ${l.y})`} class="wm-lm">
              <g class="wm-lm-art" set:html={ICON[l.key] ?? ''} />
              <text y="22" class="wm-lm-name">{l.name}</text>
            </g>
          ))}
        </g>

        <g class="wm-stations">
          {MAP_STATIONS.map((s) => (
            <g transform={`translate(${s.x} ${s.y})`} class={`wm-st ${s.minor ? "wm-st-minor" : ""}`}>
              <g class="wm-st-in"><circle r="6" class="wm-st-dot" /><text x="9" y="4" class="wm-st-name">{s.name}駅</text></g>
            </g>
          ))}
        </g>

        <g class="wm-line-names" aria-hidden="true">
          {MAP_SUBWAYS.map((l) => SUBWAY_LABEL[l.key] && (
            <g transform={`translate(${SUBWAY_LABEL[l.key]!.x} ${SUBWAY_LABEL[l.key]!.y})`} class="wm-ln"><g class="wm-ln-in">
              <rect x={-l.name.length * 6.2 - 6} y="-10" width={l.name.length * 12.4 + 12} height="20" rx="10" style={`fill:${l.color}`} /><text y="4">{l.name}</text>
            </g></g>
          ))}
          {yuriLabel && <g transform={`translate(${yuriLabel.x - 20} ${yuriLabel.y})`} class="wm-ln"><g class="wm-ln-in"><rect x="-35" y="-10" width="70" height="20" rx="10" style="fill:#2b6cb0" /><text y="4">ゆりかもめ</text></g></g>}
        </g>

        <g class="wm-areas">
          {MAP_REF_AREAS.map((a) => <text x={a.x} y={a.y} class="wm-ref-name">{a.name}</text>)}
          {MAP_AREAS.map((a) => (
            <a href={`/tags/${a.tag}/`} class="wm-area">
              <text x={a.x} y={a.y} class="wm-area-name">{a.tag}</text>
              <text x={a.x} y={a.y + 18} class="wm-area-ward">{a.ward}</text>
            </a>
          ))}
        </g>

        <g class="wm-pins" data-pins>
          {items.map((it, i) => (
            <a href={`/posts/${it.slug}/`} class={`wm-pin wm-pin-${it.kind}`} data-i={i} aria-label={`${it.title}（${it.kind === 'event' ? jpRange(it.start, it.end || undefined) : jpDate(it.start)}・${it.place}）`}>
              <g transform={`translate(${it.x} ${it.y})`}><g class="wm-pin-scale">
                <circle r="22" cy="-30" class="wm-pin-pulse" />
                <g class="wm-pin-drop">
                  <path d="M0 0l-7-10h14z" class="wm-pin-tail" />
                  <circle cy="-30" r="22" class="wm-pin-ring" />
                  <clipPath id={`wm-clip-${i}`}><circle cy="-30" r="18" /></clipPath>
                  {it.img ? <image href={it.img} x="-18" y="-48" width="36" height="36" preserveAspectRatio="xMidYMid slice" clip-path={`url(#wm-clip-${i})`} /> : <circle cy="-30" r="18" class="wm-pin-noimg" />}
                  <g transform="translate(15 -47)" class="wm-pin-badge"><rect x="-13" y="-9" width="26" height="18" rx="9" /><text class="wm-pin-badge-t">{it.kind === 'event' ? `${Number(it.start.slice(5, 7))}/${Number(it.start.slice(8, 10))}` : 'NEW'}</text></g>
                </g>
              </g></g>
            </a>
          ))}
        </g>
      </svg>
      {/* 2026-11-03 利用者「キャラアイコンはマップ上にうまく散りばめて／注目のイベントの近くを解説する形で配置／吹き出しはもっと控えめに」 */}
      <div class="wmap-guides" data-guides aria-hidden="true"></div>
    </div>

    <div class="wmap-pop" data-pop hidden role="dialog" aria-label="イベントの詳細">
      <button type="button" class="wmap-pop-x" data-pop-close aria-label="閉じる">×</button>
      <a data-pop-link class="wmap-pop-link">
        <img data-pop-img alt="" />
        <span class="wmap-pop-body">
          <span class="wmap-pop-meta" data-pop-meta></span>
          <span class="wmap-pop-title" data-pop-title></span>
          <span class="wmap-pop-place" data-pop-place></span>
          <span class="wmap-pop-go">記事を読む →</span>
        </span>
      </a>
    </div>

    <p class="wmap-pill" data-pill>📍 今日の湾岸</p>
    <div class="wmap-zoom">
      <button type="button" data-zoom="in" aria-label="拡大">＋</button>
      <button type="button" data-zoom="out" aria-label="縮小">－</button>
      <button type="button" data-zoom="reset" aria-label="湾岸の全体を表示">⤢</button>
    </div>
    <div class="wmap-dock" role="toolbar" aria-label="イベントを期間で絞り込む">
      <button type="button" class="wmap-chip is-on" data-period="all"><i aria-hidden="true">🗺️</i>すべて<b data-count="all"></b></button>
      <button type="button" class="wmap-chip" data-period="today"><i aria-hidden="true">🎉</i>今日<b data-count="today"></b></button>
      <button type="button" class="wmap-chip" data-period="week"><i aria-hidden="true">📅</i>今週<b data-count="week"></b></button>
      <button type="button" class="wmap-chip" data-period="nextweek"><i aria-hidden="true">🗓️</i>来週<b data-count="nextweek"></b></button>
      <button type="button" class="wmap-chip" data-period="month"><i aria-hidden="true">🍂</i>今月<b data-count="month"></b></button>
      <button type="button" class="wmap-chip" data-period="nextmonth"><i aria-hidden="true">🎄</i>来月<b data-count="nextmonth"></b></button>
      <button type="button" class="wmap-chip" data-period="year"><i aria-hidden="true">🎍</i>今年<b data-count="year"></b></button>
      <span class="wmap-dock-sep" aria-hidden="true"></span>
      <button type="button" class="wmap-chip wmap-tog" data-tog="free" aria-pressed="false"><i aria-hidden="true">🆓</i>無料だけ</button>
    </div>
    <p class="wmap-credit">地図：{MAP_SOURCE}をもとに作成／駅：© OpenStreetMap contributors</p>
  </div>

  {/* 地図の枠のすぐ下に差し込む（湾岸ライフの一覧の「地区から探す」・2026-11-07） */}
  <slot name="below-map" />
  <ol class="wmap-list" data-list>
    {items.map((it, i) => (
      <li data-i={i} class={`wmap-li wmap-li-${it.kind}`}>
        <button type="button" data-goto={i} aria-label={`地図で${it.short}を見る`}>📍</button>
        <span class="wmap-li-date">{it.kind === 'event' ? jpRange(it.start, it.end || undefined) : `${jpDate(it.start)}のニュース`}</span>
        <a href={`/posts/${it.slug}/`}>{it.title}</a>
        <span class="wmap-li-place">{it.area && `${it.area}・`}{it.place}{it.kind === 'event' && (it.isFree ? '・無料' : '')}</span>
      </li>
    ))}
  </ol>
  <script type="application/json" data-wmap-data set:html={data} />
</div>

<script>
  type Item = { kind: 'event' | 'news'; slug: string; title: string; short: string; start: string; end: string; place: string; area: string; isFree: boolean; img: string; pop?: string; x: number; y: number };
  const WD = ['日', '月', '火', '水', '木', '金', '土'];
  const jp = (s: string) => { const [y, m, d] = s.split('-').map(Number); return `${m}月${d}日（${WD[new Date(Date.UTC(y, m - 1, d)).getUTCDay()]}）`; };
  const add = (s: string, n: number) => { const t = new Date(s + 'T00:00:00Z'); t.setUTCDate(t.getUTCDate() + n); return t.toISOString().slice(0, 10); };
  const pad = (n: number) => String(n).padStart(2, '0');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hoverable = matchMedia('(hover: hover)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-wmap]')) {
    const { today: buildDay, items, pan: PAN } = JSON.parse(root.querySelector('[data-wmap-data]')!.textContent || '{}') as { today: string; items: Item[]; pan: { x: number; y: number; w: number; h: number } };
    const nowJst = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
    const today = nowJst > buildDay ? nowJst : buildDay;
    const endOf = (it: Item) => (it.kind === 'news' ? it.start : it.end || add(it.start, 60));
    const range = (k: string): [string, string] => {
      const [y, m, d] = today.split('-').map(Number);
      const dow = (new Date(Date.UTC(y, m - 1, d)).getUTCDay() + 6) % 7; const mon = add(today, -dow);
      const last = (yy: number, mm: number) => new Date(Date.UTC(yy, mm, 0)).getUTCDate();
      switch (k) {
        case 'today': return [today, today];
        case 'week': return [mon, add(mon, 6)];
        case 'nextweek': return [add(mon, 7), add(mon, 13)];
        case 'month': return [`${y}-${pad(m)}-01`, `${y}-${pad(m)}-${pad(last(y, m))}`];
        case 'nextmonth': { const ny = m === 12 ? y + 1 : y, nm = m === 12 ? 1 : m + 1; return [`${ny}-${pad(nm)}-01`, `${ny}-${pad(nm)}-${pad(last(ny, nm))}`]; }
        case 'year': return [`${y}-01-01`, `${y}-12-31`];
        default: return [today, '9999-12-31'];
      }
    };
    let period = 'all'; let freeOnly = false;
    const isOn = (it: Item) => it.kind === 'event' && it.start <= today && today <= endOf(it);
    const isSoon = (it: Item) => it.kind === 'event' && it.start > today && it.start <= add(today, 7);
    const match = (it: Item, p = period) => {
      if (endOf(it) < today) return false;
      if (freeOnly && !(it.kind === 'event' && it.isFree)) return false;
      if (p === 'all') return true;
      if (it.kind === 'news') return p === 'today' || p === 'week';
      const [a, b] = range(p); return it.start <= b && endOf(it) >= a;
    };

    const pins = [...root.querySelectorAll<SVGAElement>('.wm-pin')];
    const lis = [...root.querySelectorAll<HTMLElement>('.wmap-li')];
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const pill = root.querySelector<HTMLElement>('[data-pill]')!;
    const guidesBox = root.querySelector<HTMLElement>('[data-guides]')!;
    const pop = root.querySelector<HTMLElement>('[data-pop]')!;
    const ratio = parseFloat(getComputedStyle(root).getPropertyValue('--wm-ratio')) || 1;
    const LABEL: Record<string, string> = { all: 'これからの湾岸', today: '今日の湾岸', week: '今週の湾岸', nextweek: '来週の湾岸', month: '今月の湾岸', nextmonth: '来月の湾岸', year: '今年の湾岸' };

    const render = () => {
      items.forEach((it, i) => {
        const show = match(it);
        pins[i].classList.toggle('is-hidden', !show);
        pins[i].classList.toggle('is-now', show && isOn(it));
        pins[i].classList.toggle('is-soon', show && isSoon(it));
        lis[i].hidden = !show;
      });
      // 開催中のピンの波紋（動く絵の層に置く・2026-11-08）
      const mv = root.querySelector('[data-movers]');
      if (mv) { mv.querySelectorAll('.wm-pulse').forEach((e) => e.remove()); items.forEach((it, i) => { if (!pins[i].classList.contains('is-now')) return; const d = document.createElement('div'); d.className = 'wm-pulse'; d.style.left = `${it.x}px`; d.style.top = `${it.y}px`; mv.appendChild(d); }); }
      const [a, b] = range(period);
      pill.textContent = `📍 ${LABEL[period]}${period === 'all' ? '' : `（${jp(a)}${a !== b ? `〜${jp(b)}` : ''}）`}・${items.filter((it) => match(it)).length}件`;
      for (const k of Object.keys(LABEL)) { const el = root.querySelector(`[data-count="${k}"]`); if (el) el.textContent = String(items.filter((it) => match(it, k)).length); }
    };

    // ── 拡大・移動 ──
    let z = 1, tx = 0, ty = 0;
    const zoomOutBtn = root.querySelector<HTMLButtonElement>('[data-zoom="out"]'), zoomInBtn = root.querySelector<HTMLButtonElement>('[data-zoom="in"]');
    const cw = () => stage.clientWidth, ch = () => stage.clientWidth * ratio;
    // 2026-11-03 利用者「マイナスを押し続けると何も表示されていない青い部分が出る／一定の回数でもう押せないように」: 地図が枠を埋める大きさが下限
    // 2026-11-03 利用者「マイナスの縮小はもう少し押せるようにして」: 枠を埋める大きさからさらに 2 回（1.5 倍ずつ）まで。ただし地図の全体が収まる大きさより小さくはしない（それ以上は何も無い海しか増えない）
    // 2026-11-03 利用者「－を押した時はもっと広範囲の地図を表示して／押せる回数が少なすぎる／左右がすぐに消えてデザイン上ひどい」:
    // 外側の陸（MAP_PAN の範囲）まで描いたので、その範囲が枠をちょうど埋める大きさまで縮められる
    const minZ = () => { const k = cw() / 1000; return Math.max(stage.clientWidth / (PAN.w * k), stage.clientHeight / (PAN.h * k)); };
    const clamp = () => {
      const w = stage.clientWidth, h = stage.clientHeight, W = cw() * z, Hh = ch() * z;
      // 動かせるのは外側の陸（PAN）の範囲まで。枠の外に海の切れ目を出さない
      const k = cw() / 1000, L = PAN.x * k * z, T = PAN.y * k * z, R = (PAN.x + PAN.w) * k * z, B = (PAN.y + PAN.h) * k * z;
      tx = Math.min(-L, Math.max(w - R, tx)); ty = Math.min(-T, Math.max(h - B, ty));
      void W; void Hh;
    };
    // 焼いた画像（湾岸の外の路線・札）は、地図を置いてから読み込む。最初の表示の回線を取り合わない
    // ── 地図の画像（タイル）: 地図アプリと同じく、見えている所の細かい画像だけ読み、遠くなったら外す ──
    // 粗い 1 枚（base-lo・1 単位 1 画素）を下に敷き、拡大して粗さが見える大きさになったら 1 単位 3 画素のタイル（256 単位四方）を重ねる
    const tilesBox = root.querySelector<HTMLDivElement>('[data-tiles]');
    const TILE = 256, COLS = Math.ceil(PAN.w / TILE), ROWS = Math.ceil(PAN.h / TILE);
    const tiles = new Map<string, HTMLImageElement>();
    const dpr = Math.min(3, window.devicePixelRatio || 1);
    // 細かいタイルは、ページの読み込みが終わってから（最初の表示は粗い 1 枚で出し、回線を取り合わない）。先に触られたらその時点で
    let tilesOk = false;
    // 2026-11-08 利用者が「細かい地図の画像を先読み・2段階にする」を選んだ:
    // ① 拡大しすぎていないときは 1 単位 2 画素のタイル（tiles2・画素が約半分）を使い、もっと拡大したら 3 画素（tiles）に切り替える
    // ② 画像は展開（decode）が終わってから画面に足す（ドラッグ中に展開の待ちで引っかからない）
    // ③ 動かしている向きの先を 1 列多く読んでおく
    let tileLevel = 0, lastTx = 0, lastTy = 0, dirX = 0, dirY = 0;
    const updateTiles = () => {
      if (!tilesBox || !tilesOk) return;
      const k = cw() / 1000, s = k * z; // 画面の 1 単位あたりの CSS 画素
      const dev = s * dpr;               // 1 単位あたりの画面の画素
      const level = dev <= 1.25 ? 0 : dev <= 2.1 ? 2 : 3; // 0 = 粗い 1 枚で足りる
      tilesBox.hidden = !level;
      if (level !== tileLevel) { const keep = tiles; tileLevel = level; if (!level) { for (const im of keep.values()) im.remove(); keep.clear(); return; } setTimeout(() => { for (const [key, im] of keep) if (!key.startsWith(`${level}:`)) { im.remove(); keep.delete(key); } }, 700); }
      if (!level) return;
      if (tx !== lastTx) dirX = tx < lastTx ? 1 : -1; if (ty !== lastTy) dirY = ty < lastTy ? 1 : -1; lastTx = tx; lastTy = ty;
