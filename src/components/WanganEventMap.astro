    function sideGuides() { const k = cw() / 1000, W = stage.clientWidth; root.querySelectorAll<HTMLElement>('.wmap-g').forEach((g) => { const sx = tx + Number(g.dataset.x) * k * z; const b = g.querySelector<HTMLElement>('.wmap-g-bubble'); if (b) { b.style.maxWidth = ''; b.style.whiteSpace = ''; } const need = (g.querySelector<HTMLElement>('.wmap-g-in')?.offsetWidth ?? 160) + 30; const left = W - sx < need && sx > W - sx; g.classList.toggle('is-left', left); const room = (left ? sx : W - sx) - 62; if (b && b.offsetWidth > room) { b.style.whiteSpace = 'normal'; b.style.maxWidth = `${Math.max(70, room)}px`; } }); }
