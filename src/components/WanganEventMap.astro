    const pts = new Map<number, { x: number; y: number }>(); let last: { x: number; y: number; d: number } | null = null; let moved = false;
    // 2026-11-07 利用者「手のアイコンで移動するときに移動が少し遅い／もっさりしていて滑らかさがない」:
    // ① ドラッグ中は 0.25 秒のアニメーションを切る（指より遅れてついてきていた） ② 指の動きの 1.5 倍動かす ③ 離したあとも少し滑らせる
