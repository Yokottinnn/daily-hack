    // 2026-11-07 利用者「モバイルで非常にもっさりして全然動かない」: 動く絵（船・魚・電車・波・雲）が地図全体を毎フレーム描き直させていた
    // （遅い CPU で測ると、全部止めると描画が 30 → 50 回／秒、ドラッグが 2.7 → 1.3 秒）。動かしている間は止め、離して止まったら再開する
    // 動く絵は別の SVG（.wmap-anim）に分けた（2026-11-08）。止める・動かすはその層に対して行う
    // 動く絵の箱（地図の 1 単位 = 1px）を、地図の幅に合わせて縮める。幅が変わったときも合わせる
    const movers = root.querySelector<HTMLDivElement>('[data-movers]');
    const fitMovers = () => { if (movers) movers.style.transform = `scale(${canvas.clientWidth / 1000})`; };
    fitMovers(); addEventListener('resize', fitMovers);
    // 電車と船: 道筋の点を先に計算し、「位置と向き（transform）」だけを動かす。道筋に沿って動かす指定（offset-path）だと、
    // ブラウザが動くたびに絵を描き直していた（iPhone 相当の測定で、何もしない 3 秒のうち約 400ms）。transform だけなら描き直さない
    if (movers && !reduce) {
      const NS = 'http://www.w3.org/2000/svg';
      movers.querySelectorAll<HTMLElement>('.wm-mv[data-path]').forEach((el) => {
        const path = document.createElementNS(NS, 'path'); path.setAttribute('d', el.dataset.path || '');
        const len = path.getTotalLength(); const n = Math.max(24, Math.min(160, Math.round(len / 12))); const rot = el.dataset.rot === '1';
        const frames: Keyframe[] = [];
        for (let k = 0; k <= n; k++) {
          const at = (len * k) / n, pt = path.getPointAtLength(at);
          let a = 0; if (rot) { const p2 = path.getPointAtLength(Math.min(len, at + 1)), p1 = path.getPointAtLength(Math.max(0, at - 1)); a = (Math.atan2(p2.y - p1.y, p2.x - p1.x) * 180) / Math.PI; }
          frames.push({ transform: `translate(${pt.x.toFixed(1)}px, ${pt.y.toFixed(1)}px)${rot ? ` rotate(${a.toFixed(1)}deg)` : ''}` });
        }
        el.animate(frames, { duration: Number(el.dataset.go || 20) * 1000, delay: Number(el.dataset.delay || 0) * 1000, iterations: Infinity, direction: 'alternate', easing: 'linear' });
      });
    }
    // 2026-11-08 利用者が「見ていないときは動く絵を止める」を選んだ: 地図が画面の外にあるとき・別のタブを見ているときは止める。戻れば動く
    let offscreen = false;
    const syncAnim = () => {
      const stop = dragging || offscreen || document.hidden || reduce;
      root.classList.toggle('is-off', offscreen || document.hidden);
      root.classList.toggle('is-still', stop);
