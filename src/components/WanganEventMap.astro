---
/**
 * 湾岸エリアイベントマップ（2026-11-02 作成・11-03 利用者の 7 件の指摘で作り直し）。湾岸ライフの一覧と /wangan-map/ に置く。
 * - 地図: イラスト調の SVG。陸の形は国土地理院の地図から取った海岸線（新橋・銀座〜有明・青海。辰巳は外した）
 * - ピン: 記事の `event:` から毎朝のビルドで入れ替わる。触れる・押すと地図の上に小窓が出る
 * - 期間: すべて／今日／今週／来週／今月／来月／今年 から選ぶ（日付の帯はやめた）
 * - 動く絵: 船・屋形船・ゆりかもめ・かもめ・雲の影。ハッカー子が開催中のものから案内する
 * 動きは prefers-reduced-motion で止める。
 */
import { MAP_W, MAP_H, MAP_LAND, MAP_AREAS, MAP_LANDMARKS, MAP_SOURCE, MAP_STATIONS, MAP_YURIKAMOME, MAP_REF_AREAS, mapItems } from '../lib/wangan-map';
import { todayJst, jpDate, jpRange } from '../lib/wangan';
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'posts'>[]; headingLevel?: 'h1' | 'h2'; title?: string; lead?: boolean }
const { posts, headingLevel = 'h2', title = '湾岸エリアイベントマップ', lead = true } = Astro.props;
const today = todayJst();
const items = mapItems(posts, today);
const H = headingLevel;
const WARD_FILL: Record<string, string> = { 中央区: 'var(--wm-land-chuo)', 江東区: 'var(--wm-land-koto)' };

// ゆりかもめの線（駅を通るなめらかな線）
const rail = MAP_YURIKAMOME.length > 1
  ? MAP_YURIKAMOME.reduce((d, s, i, a) => {
      if (i === 0) return `M${s.x},${s.y}`;
      const p = a[i - 1];
      const mx = (p.x + s.x) / 2, my = (p.y + s.y) / 2;
      return `${d} Q${p.x},${p.y} ${mx},${my}`;
    }, '') + ` T${MAP_YURIKAMOME.at(-1)!.x},${MAP_YURIKAMOME.at(-1)!.y}`
  : '';
const at = (k: string) => MAP_STATIONS.find((s) => s.key === k);
const tsuki = at('月島駅'), kachi = at('勝どき駅');

// 目印の絵（ 0,0 が建物の足元。横 ±30 ほど）
const ICON: Record<string, string> = {
  // 晴海トリトン: 3 本の高層棟（ガラスの縦の帯）と低層の土台
  triton: `<rect x="-30" y="-6" width="60" height="10" rx="2" class="b"/>
    <path d="M-24 -6V-52h14V-6" class="g"/><path d="M-7 -6V-62h14V-6" class="g"/><path d="M10 -6V-46h14V-6" class="g"/>
    <path d="M-20 -48v40M-14 -48v40M-3 -58v50M3 -58v50M14 -42v34M20 -42v34" class="l2"/>
    <path d="M-24 -52h14M-7 -62h14M10 -46h14" class="l"/>`,
  // 晴海フラッグ: 色違いの中層棟が並び、真ん中に 2 本のタワー。旗
  'harumi-flag': `<rect x="-34" y="-20" width="16" height="22" class="c1"/><rect x="-16" y="-26" width="14" height="28" class="c2"/>
    <rect x="18" y="-22" width="16" height="24" class="c3"/><path d="M0 2V-56h8V2M10 2V-50h7V2" class="g"/>
    <path d="M-30 -14h8M-30 -8h8M-12 -20h6M-12 -14h6M22 -16h8M22 -10h8" class="l2"/>
    <path d="M4 -56v-12" class="l"/><path d="M4 -68l12 4-12 4z" class="a"/><rect x="-36" y="2" width="72" height="4" rx="2" class="gr"/>`,
  // 豊洲市場: 長い低い屋根の棟が 2 つ
  market: `<path d="M-34 0h30v-12l-15-6-15 6z" class="b"/><path d="M2 0h32v-12l-16-7-16 7z" class="b"/>
    <path d="M-30 -6h22M6 -6h24" class="l2"/><path d="M-20 -26c4-5 10-5 14 0-4 5-10 5-14 0z" class="a"/><path d="M-6 -26l5-3v6z" class="a"/>`,
  // ららぽーと豊洲: 船のかたちのモール
  lalaport: `<path d="M-34 -8h68l-10 12h-48z" class="b"/><rect x="-24" y="-20" width="40" height="12" rx="3" class="c2"/>
    <path d="M-4 -20V-40l18 18z" class="a"/><path d="M-18 -14h28" class="l2"/>`,
  'ariake-arena': `<path d="M-32 2a32 24 0 0 1 64 0z" class="b"/><path d="M-22 2a22 15 0 0 1 44 0" class="l2"/><path d="M-32 2h64" class="l"/>`,
  'ariake-garden': `<rect x="-30" y="-12" width="60" height="14" rx="3" class="b"/><rect x="-8" y="-34" width="16" height="22" class="g"/>
    <circle cx="-20" cy="-16" r="8" class="t"/><circle cx="22" cy="-17" r="9" class="t"/>`,
  // 東京ビッグサイト: 逆さのピラミッドが 4 つ
  bigsight: `<rect x="-30" y="-6" width="60" height="8" class="b"/><path d="M-30 -6l6-10V-26h-10zM-14 -26h14l-4 10v10h-6v-10z" class="g"/>
    <path d="M4 -26h14l-4 10v10h-6v-10zM22 -26h12l-4 10v10h-4z" class="g"/>`,
  diversity: `<rect x="-30" y="-24" width="60" height="26" rx="3" class="b"/><path d="M-30 -14h60" class="l2"/><rect x="-6" y="-34" width="12" height="10" class="a"/>`,
  // 月島もんじゃストリート: のれんの店が並ぶ
  monja: `<rect x="-30" y="-16" width="20" height="18" class="b"/><rect x="-8" y="-18" width="18" height="20" class="b"/><rect x="12" y="-15" width="18" height="17" class="b"/>
    <path d="M-30 -16h20v6h-20zM-8 -18h18v6h-18zM12 -15h18v6h-18z" class="a"/><ellipse cx="0" cy="10" rx="9" ry="3" class="c3"/>`,
  bousai: `<circle cx="-14" cy="-12" r="11" class="t"/><circle cx="8" cy="-16" r="13" class="t"/><circle cx="24" cy="-8" r="8" class="t"/><rect x="-2" y="-6" width="3" height="8" class="b"/>`,
};
const data = JSON.stringify({ today, items });
const ratio = (MAP_H / MAP_W).toFixed(4);
---

<section class="wmap" aria-labelledby="wmap-title" data-wmap style={`--wm-ratio:${ratio}`}>
  <div class="wmap-head">
    <H id="wmap-title" class="wmap-title">{title}<span>（{jpDate(today)}時点）</span></H>
    {lead && <p class="wmap-lead">晴海・勝どき・月島・豊洲・有明・青海（中央区・江東区）で、<strong>いま開いているイベントとこれから始まるイベント</strong>を地図に置いた。ピンに触れると、その場で日付・会場・料金が出る。下の帯で「今週」「来月」のように期間を選べるわよ。</p>}
  </div>

  <div class="wmap-stage" data-stage>
    <div class="wmap-canvas" data-canvas>
      <svg class="wmap-svg" viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-labelledby="wmap-svg-title">
        <title id="wmap-svg-title">湾岸エリア（中央区・江東区）のイベントマップ。新橋・銀座から晴海・豊洲・有明・青海まで</title>
        <defs>
          <pattern id="wm-wave" width="60" height="22" patternUnits="userSpaceOnUse"><path d="M2 14c6-6 12-6 18 0s12 6 18 0" class="wm-wave-line" /></pattern>
          <pattern id="wm-dots" width="10" height="10" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="0.9" class="wm-dot" /></pattern>
          <filter id="wm-rough" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" /><feDisplacementMap in="SourceGraphic" scale="5" /></filter>
          <filter id="wm-shadow" x="-10%" y="-10%" width="120%" height="120%"><feDropShadow dx="0" dy="6" stdDeviation="4" flood-color="#1d4e7a" flood-opacity="0.2" /></filter>
          <radialGradient id="wm-cloud"><stop offset="0" stop-color="#2a5a80" stop-opacity="0.16" /><stop offset="1" stop-color="#2a5a80" stop-opacity="0" /></radialGradient>
        </defs>
        <rect width={MAP_W} height={MAP_H} class="wm-sea" />
        <rect width={MAP_W} height={MAP_H} fill="url(#wm-wave)" class="wm-waves" />
        <g filter="url(#wm-shadow)"><g filter="url(#wm-rough)">
          {MAP_LAND.map((l) => <path d={l.d} class={`wm-land ${WARD_FILL[l.ward] ? '' : 'wm-land-out'}`} style={WARD_FILL[l.ward] ? `fill:${WARD_FILL[l.ward]}` : ''} />)}
        </g></g>
        <g filter="url(#wm-rough)" opacity="0.45">{MAP_LAND.map((l) => <path d={l.d} fill="url(#wm-dots)" />)}</g>

        {/* 動く絵（海） */}
        <g class="wm-anim" aria-hidden="true">
          <path id="wm-route1" d={`M60 ${MAP_H * 0.86} C 120 ${MAP_H * 0.72}, 150 ${MAP_H * 0.6}, 210 ${MAP_H * 0.5}`} fill="none" />
          <g class="wm-ship"><g transform="scale(1.7)"><path d="M-16 0h32l-7 8h-18z" class="b" /><rect x="-10" y="-6" width="18" height="6" rx="1.5" class="b" /><rect x="-5" y="-11" width="9" height="5" rx="1.5" class="a" /></g>
            <animateMotion dur="40s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#wm-route1" /></animateMotion></g>
          {tsuki && <path id="wm-route2" d={`M${tsuki.x - 150} ${tsuki.y - 90} Q ${tsuki.x - 70} ${tsuki.y + 20}, ${tsuki.x - 40} ${tsuki.y + 170}`} fill="none" />}
          {tsuki && <g class="wm-yakata"><g transform="scale(1.4)"><path d="M-18 2h36l-5 6h-26z" class="b" /><rect x="-14" y="-7" width="28" height="9" rx="1" class="c2" /><path d="M-16 -7h32l-4-5h-24z" class="a" /><circle cx="-8" cy="-3" r="1.6" class="lamp" /><circle cx="0" cy="-3" r="1.6" class="lamp" /><circle cx="8" cy="-3" r="1.6" class="lamp" /></g>
            <animateMotion dur="55s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#wm-route2" /></animateMotion></g>}
          <path id="wm-gull" d={`M ${MAP_W * 0.62} ${MAP_H * 0.3} c 80 -40 160 20 120 80 s -160 40 -120 -80`} fill="none" />
          {[0, 1, 2].map((i) => (
            <g class="wm-gull-g"><path d="M-8 0q4-6 8 0q4-6 8 0" class="gull" />
              <animateMotion dur={`${18 + i * 4}s`} begin={`-${i * 5}s`} repeatCount="indefinite" rotate="auto"><mpath href="#wm-gull" /></animateMotion></g>
          ))}
          <ellipse cx="0" cy="0" rx="160" ry="70" fill="url(#wm-cloud)" class="wm-cloud1" />
          <ellipse cx="0" cy="0" rx="120" ry="55" fill="url(#wm-cloud)" class="wm-cloud2" />
        </g>

        {/* ゆりかもめ */}
        {rail && (
          <g class="wm-rail" aria-hidden="true">
            <path id="wm-yuri" d={rail} class="wm-rail-bed" />
            <path d={rail} class="wm-rail-line" />
            <g class="wm-train"><g transform="scale(1.3)"><rect x="-22" y="-5" width="13" height="10" rx="3" class="tr" /><rect x="-7" y="-5" width="13" height="10" rx="2" class="tr" /><rect x="8" y="-5" width="13" height="10" rx="3" class="tr" /><path d="M-19 -2h7M-4 -2h7M11 -2h7" class="win" /></g>
              <animateMotion dur="34s" repeatCount="indefinite" rotate="auto" keyPoints="0;1;0" keyTimes="0;0.5;1" calcMode="linear"><mpath href="#wm-yuri" /></animateMotion></g>
          </g>
        )}

        <g class="wm-landmarks" aria-hidden="true">
          {MAP_LANDMARKS.map((l) => (
            <g transform={`translate(${l.x} ${l.y})`} class="wm-lm">
              <g class="wm-lm-art" set:html={ICON[l.key] ?? ''} />
              <text y="22" class="wm-lm-name">{l.name}</text>
            </g>
          ))}
        </g>

        <g class="wm-stations">
          {MAP_STATIONS.map((s) => (
            <g transform={`translate(${s.x} ${s.y})`} class={`wm-st ${s.minor ? "wm-st-minor" : ""}`}>
              <g class="wm-st-in"><circle r="6" class="wm-st-dot" /><text x="9" y="4" class="wm-st-name">{s.name}駅</text></g>
            </g>
          ))}
        </g>

        <g class="wm-areas">
          {MAP_REF_AREAS.map((a) => <text x={a.x} y={a.y} class="wm-ref-name">{a.name}</text>)}
          {MAP_AREAS.map((a) => (
            <a href={`/tags/${a.tag}/`} class="wm-area">
              <text x={a.x} y={a.y} class="wm-area-name">{a.tag}</text>
              <text x={a.x} y={a.y + 18} class="wm-area-ward">{a.ward}</text>
            </a>
          ))}
        </g>

        <g class="wm-pins" data-pins>
          {items.map((it, i) => (
            <a href={`/posts/${it.slug}/`} class={`wm-pin wm-pin-${it.kind}`} data-i={i} aria-label={`${it.title}（${it.kind === 'event' ? jpRange(it.start, it.end || undefined) : jpDate(it.start)}・${it.place}）`}>
              <g transform={`translate(${it.x} ${it.y})`}><g class="wm-pin-scale">
                <circle r="22" cy="-30" class="wm-pin-pulse" />
                <g class="wm-pin-drop">
                  <path d="M0 0l-7-10h14z" class="wm-pin-tail" />
                  <circle cy="-30" r="22" class="wm-pin-ring" />
                  <clipPath id={`wm-clip-${i}`}><circle cy="-30" r="18" /></clipPath>
                  {it.img ? <image href={it.img} x="-18" y="-48" width="36" height="36" preserveAspectRatio="xMidYMid slice" clip-path={`url(#wm-clip-${i})`} /> : <circle cy="-30" r="18" class="wm-pin-noimg" />}
                  <g transform="translate(15 -47)" class="wm-pin-badge"><rect x="-13" y="-9" width="26" height="18" rx="9" /><text class="wm-pin-badge-t">{it.kind === 'event' ? `${Number(it.start.slice(5, 7))}/${Number(it.start.slice(8, 10))}` : 'NEW'}</text></g>
                </g>
              </g></g>
            </a>
          ))}
        </g>
      </svg>

      <div class="wmap-guide" data-guide aria-live="polite">
        <div class="wmap-guide-bubble" data-guide-text>案内するわよ！</div>
        <img src="/images/expr-01-wave.png" alt="" class="wmap-guide-face" width="72" height="72" data-guide-face />
      </div>
    </div>

    <div class="wmap-pop" data-pop hidden role="dialog" aria-label="イベントの詳細">
      <button type="button" class="wmap-pop-x" data-pop-close aria-label="閉じる">×</button>
      <a data-pop-link class="wmap-pop-link">
        <img data-pop-img alt="" />
        <span class="wmap-pop-body">
          <span class="wmap-pop-meta" data-pop-meta></span>
          <span class="wmap-pop-title" data-pop-title></span>
          <span class="wmap-pop-place" data-pop-place></span>
          <span class="wmap-pop-go">記事を読む →</span>
        </span>
      </a>
    </div>

    <p class="wmap-pill" data-pill>📍 今日の湾岸</p>
    <div class="wmap-zoom">
      <button type="button" data-zoom="in" aria-label="拡大">＋</button>
      <button type="button" data-zoom="out" aria-label="縮小">－</button>
      <button type="button" data-zoom="reset" aria-label="湾岸の全体を表示">⤢</button>
    </div>
    <div class="wmap-dock" role="toolbar" aria-label="イベントを期間で絞り込む">
      <button type="button" class="wmap-chip is-on" data-period="all"><i aria-hidden="true">🗺️</i>すべて<b data-count="all"></b></button>
      <button type="button" class="wmap-chip" data-period="today"><i aria-hidden="true">🎉</i>今日<b data-count="today"></b></button>
      <button type="button" class="wmap-chip" data-period="week"><i aria-hidden="true">📅</i>今週<b data-count="week"></b></button>
      <button type="button" class="wmap-chip" data-period="nextweek"><i aria-hidden="true">🗓️</i>来週<b data-count="nextweek"></b></button>
      <button type="button" class="wmap-chip" data-period="month"><i aria-hidden="true">🍂</i>今月<b data-count="month"></b></button>
      <button type="button" class="wmap-chip" data-period="nextmonth"><i aria-hidden="true">🎄</i>来月<b data-count="nextmonth"></b></button>
      <button type="button" class="wmap-chip" data-period="year"><i aria-hidden="true">🎍</i>今年<b data-count="year"></b></button>
      <span class="wmap-dock-sep" aria-hidden="true"></span>
      <button type="button" class="wmap-chip wmap-tog" data-tog="free" aria-pressed="false"><i aria-hidden="true">🆓</i>無料だけ</button>
    </div>
    <p class="wmap-credit">地図：{MAP_SOURCE}をもとに作成／駅：© OpenStreetMap contributors</p>
  </div>

  <ol class="wmap-list" data-list>
    {items.map((it, i) => (
      <li data-i={i} class={`wmap-li wmap-li-${it.kind}`}>
        <button type="button" data-goto={i} aria-label={`地図で${it.short}を見る`}>📍</button>
        <span class="wmap-li-date">{it.kind === 'event' ? jpRange(it.start, it.end || undefined) : `${jpDate(it.start)}のニュース`}</span>
        <a href={`/posts/${it.slug}/`}>{it.title}</a>
        <span class="wmap-li-place">{it.area && `${it.area}・`}{it.place}{it.kind === 'event' && (it.isFree ? '・無料' : '')}</span>
      </li>
    ))}
  </ol>
  <script type="application/json" data-wmap-data set:html={data} />
</section>

<script>
  type Item = { kind: 'event' | 'news'; slug: string; title: string; short: string; start: string; end: string; place: string; area: string; isFree: boolean; img: string; x: number; y: number };
  const WD = ['日', '月', '火', '水', '木', '金', '土'];
  const jp = (s: string) => { const [y, m, d] = s.split('-').map(Number); return `${m}月${d}日（${WD[new Date(Date.UTC(y, m - 1, d)).getUTCDay()]}）`; };
  const add = (s: string, n: number) => { const t = new Date(s + 'T00:00:00Z'); t.setUTCDate(t.getUTCDate() + n); return t.toISOString().slice(0, 10); };
  const pad = (n: number) => String(n).padStart(2, '0');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hoverable = matchMedia('(hover: hover)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-wmap]')) {
    const { today: buildDay, items } = JSON.parse(root.querySelector('[data-wmap-data]')!.textContent || '{}') as { today: string; items: Item[] };
    const nowJst = new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
    const today = nowJst > buildDay ? nowJst : buildDay;
    const endOf = (it: Item) => (it.kind === 'news' ? it.start : it.end || add(it.start, 60));
    const range = (k: string): [string, string] => {
      const [y, m, d] = today.split('-').map(Number);
      const dow = (new Date(Date.UTC(y, m - 1, d)).getUTCDay() + 6) % 7; const mon = add(today, -dow);
      const last = (yy: number, mm: number) => new Date(Date.UTC(yy, mm, 0)).getUTCDate();
      switch (k) {
        case 'today': return [today, today];
        case 'week': return [mon, add(mon, 6)];
        case 'nextweek': return [add(mon, 7), add(mon, 13)];
        case 'month': return [`${y}-${pad(m)}-01`, `${y}-${pad(m)}-${pad(last(y, m))}`];
        case 'nextmonth': { const ny = m === 12 ? y + 1 : y, nm = m === 12 ? 1 : m + 1; return [`${ny}-${pad(nm)}-01`, `${ny}-${pad(nm)}-${pad(last(ny, nm))}`]; }
        case 'year': return [`${y}-01-01`, `${y}-12-31`];
        default: return [today, '9999-12-31'];
      }
    };
    let period = 'all'; let freeOnly = false;
    const isOn = (it: Item) => it.kind === 'event' && it.start <= today && today <= endOf(it);
    const isSoon = (it: Item) => it.kind === 'event' && it.start > today && it.start <= add(today, 7);
    const match = (it: Item, p = period) => {
      if (endOf(it) < today) return false;
      if (freeOnly && !(it.kind === 'event' && it.isFree)) return false;
      if (p === 'all') return true;
      if (it.kind === 'news') return p === 'today' || p === 'week';
      const [a, b] = range(p); return it.start <= b && endOf(it) >= a;
    };

    const pins = [...root.querySelectorAll<SVGAElement>('.wm-pin')];
    const lis = [...root.querySelectorAll<HTMLElement>('.wmap-li')];
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLElement>('[data-canvas]')!;
    const pill = root.querySelector<HTMLElement>('[data-pill]')!;
    const guide = root.querySelector<HTMLElement>('[data-guide]')!;
    const guideText = root.querySelector<HTMLElement>('[data-guide-text]')!;
    const guideFace = root.querySelector<HTMLImageElement>('[data-guide-face]')!;
    const pop = root.querySelector<HTMLElement>('[data-pop]')!;
    const ratio = parseFloat(getComputedStyle(root).getPropertyValue('--wm-ratio')) || 1;
    const LABEL: Record<string, string> = { all: 'これからの湾岸', today: '今日の湾岸', week: '今週の湾岸', nextweek: '来週の湾岸', month: '今月の湾岸', nextmonth: '来月の湾岸', year: '今年の湾岸' };

    const render = () => {
      items.forEach((it, i) => {
        const show = match(it);
        pins[i].classList.toggle('is-hidden', !show);
        pins[i].classList.toggle('is-now', show && isOn(it));
        pins[i].classList.toggle('is-soon', show && isSoon(it));
        lis[i].hidden = !show;
      });
      const [a, b] = range(period);
      pill.textContent = `📍 ${LABEL[period]}${period === 'all' ? '' : `（${jp(a)}${a !== b ? `〜${jp(b)}` : ''}）`}・${items.filter((it) => match(it)).length}件`;
      for (const k of Object.keys(LABEL)) { const el = root.querySelector(`[data-count="${k}"]`); if (el) el.textContent = String(items.filter((it) => match(it, k)).length); }
    };

    // ── 拡大・移動 ──
    let z = 1, tx = 0, ty = 0;
    const cw = () => stage.clientWidth, ch = () => stage.clientWidth * ratio;
    const minZ = () => Math.min(1, stage.clientHeight / ch());
    const clamp = () => {
      const w = stage.clientWidth, h = stage.clientHeight, W = cw() * z, Hh = ch() * z;
      tx = W <= w ? (w - W) / 2 : Math.min(0, Math.max(w - W, tx));
      ty = Hh <= h ? (h - Hh) / 2 : Math.min(0, Math.max(h - Hh, ty));
    };
    const apply = () => { clamp(); canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${z})`; root.style.setProperty('--wm-z', String(Math.max(z, 1))); root.classList.toggle('is-zoomed', z >= 2.2); placePop(); };
    const zoomAt = (nz: number, cx: number, cy: number) => { nz = Math.min(4, Math.max(minZ(), nz)); tx = cx - ((cx - tx) * nz) / z; ty = cy - ((cy - ty) * nz) / z; z = nz; apply(); };
    /** 地図の点（viewBox）を画面の真ん中へ */
    const centerOn = (mx: number, my: number, nz = z) => { z = Math.min(4, Math.max(minZ(), nz)); const k = cw() / 1000; tx = stage.clientWidth / 2 - mx * k * z; ty = stage.clientHeight / 2 - my * k * z; apply(); };
    const home = () => { const k = cw() / 1000; if (stage.clientWidth < 600) centerOn(560, 640, 1.5); else centerOn(560, 660, 1); };
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.zoom === 'reset') { home(); return; }
      zoomAt(z * (b.dataset.zoom === 'in' ? 1.5 : 1 / 1.5), stage.clientWidth / 2, stage.clientHeight / 2);
    }));
    const pts = new Map<number, { x: number; y: number }>(); let last: { x: number; y: number; d: number } | null = null; let moved = false;
    stage.addEventListener('pointerdown', (e) => { if ((e.target as Element).closest('.wmap-dock, .wmap-zoom, .wmap-pop')) return; pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); moved = false; last = null; });
    stage.addEventListener('pointermove', (e) => {
      if (!pts.has(e.pointerId)) return;
      const prev = pts.get(e.pointerId)!; pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size === 1) { const dx = e.clientX - prev.x, dy = e.clientY - prev.y; if (Math.abs(dx) + Math.abs(dy) > 1) { moved = true; stage.setPointerCapture(e.pointerId); } tx += dx; ty += dy; apply(); }
      if (pts.size === 2) { const [a, b] = [...pts.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y); const r = stage.getBoundingClientRect(); const c = { x: (a.x + b.x) / 2 - r.left, y: (a.y + b.y) / 2 - r.top }; if (last) zoomAt(z * (d / last.d), c.x, c.y); last = { ...c, d }; moved = true; }
    });
    const up = (e: PointerEvent) => { pts.delete(e.pointerId); if (pts.size < 2) last = null; };
    stage.addEventListener('pointerup', up); stage.addEventListener('pointercancel', up);
    stage.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    stage.addEventListener('wheel', (e) => { if (!e.ctrlKey) return; e.preventDefault(); const r = stage.getBoundingClientRect(); zoomAt(z * (e.deltaY < 0 ? 1.15 : 1 / 1.15), e.clientX - r.left, e.clientY - r.top); }, { passive: false });

    // ── 地図の上の小窓 ──
    let popIdx = -1;
    const toScreen = (it: Item) => { const k = cw() / 1000; return { x: tx + it.x * k * z, y: ty + it.y * k * z }; };
    function placePop() {
      if (popIdx < 0 || pop.hidden) return;
      const p = toScreen(items[popIdx]); const W = stage.clientWidth, Hs = stage.clientHeight; const pw = pop.offsetWidth, ph = pop.offsetHeight;
      let left = p.x - pw / 2, top = p.y - 64 - ph;
      if (top < 8) top = p.y + 14;
      left = Math.max(8, Math.min(W - pw - 8, left)); top = Math.max(8, Math.min(Hs - ph - 8, top));
      pop.style.left = `${left}px`; pop.style.top = `${top}px`;
    }
    const openPop = (i: number, sticky = false) => {
      const it = items[i]; popIdx = i; pop.hidden = false; pop.dataset.sticky = sticky ? '1' : '';
      (pop.querySelector('[data-pop-link]') as HTMLAnchorElement).href = `/posts/${it.slug}/`;
      const img = pop.querySelector<HTMLImageElement>('[data-pop-img]')!; img.src = it.img; img.hidden = !it.img;
      pop.querySelector('[data-pop-meta]')!.textContent = it.kind === 'news' ? `${jp(it.start)}のニュース` : `${isOn(it) ? '🎉 開催中・' : isSoon(it) ? 'もうすぐ・' : ''}${jp(it.start)}${it.end && it.end !== it.start ? `〜${jp(it.end)}` : ''}`;
      pop.querySelector('[data-pop-title]')!.textContent = it.title;
      pop.querySelector('[data-pop-place]')!.textContent = `${it.area ? it.area + '・' : ''}${it.place}${it.kind === 'event' ? (it.isFree ? '・無料' : '・料金は記事で') : ''}`;
      pins.forEach((p, k) => p.classList.toggle('is-focus', k === i));
      lis.forEach((l, k) => l.classList.toggle('is-focus', k === i));
      requestAnimationFrame(placePop);
    };
    const closePop = () => { pop.hidden = true; popIdx = -1; pins.forEach((p) => p.classList.remove('is-focus')); lis.forEach((l) => l.classList.remove('is-focus')); };
    pins.forEach((p, i) => {
      p.addEventListener('click', (e) => { e.preventDefault(); if (popIdx === i && pop.dataset.sticky) { location.href = `/posts/${items[i].slug}/`; return; } openPop(i, true); say(i); stopTour(); });
      if (hoverable) { p.addEventListener('mouseenter', () => { if (!pop.dataset.sticky || pop.hidden) openPop(i); }); p.addEventListener('focus', () => openPop(i)); }
    });
    stage.addEventListener('mouseleave', () => { if (!pop.dataset.sticky) closePop(); });
    root.querySelector('[data-pop-close]')!.addEventListener('click', () => { closePop(); startTour(); });
    lis.forEach((l, i) => {
      if (hoverable) l.addEventListener('mouseenter', () => { if (!pins[i].classList.contains('is-hidden')) openPop(i); });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.goto); const it = items[i];
      stage.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      centerOn(it.x, it.y, Math.max(z, 2)); openPop(i, true); say(i); stopTour();
    }));

    // ── ハッカー子の案内 ──
    const FACES = ['/images/expr-01-wave.png', '/images/expr-04-cheer.png', '/images/expr-05-smug.png', '/images/expr-07-gasp.png'];
    let tourIdx = -1, tourTimer = 0;
    function say(i: number, text?: string) {
      const it = items[i];
      guide.style.left = `${it.x / 10}%`; guide.style.top = `${(it.y / (1000 * ratio)) * 100}%`;
      guide.classList.remove('is-hop'); void guide.offsetWidth; guide.classList.add('is-hop');
      guide.classList.toggle('is-left', it.x > 620);
      guideFace.src = FACES[i % FACES.length];
      guideText.textContent = text ?? `${it.area || it.place}の「${it.short}」${it.kind === 'news' ? 'のニュース' : isOn(it) ? 'は開催中！' : `は${jp(it.start)}から`}`;
    }
    const tourList = () => items.map((it, i) => ({ it, i })).filter(({ it }) => match(it)).sort((a, b) => Number(isOn(b.it)) - Number(isOn(a.it)) || a.it.start.localeCompare(b.it.start));
    const step = () => { const l = tourList(); if (!l.length) { guideText.textContent = 'この期間のイベントは無いわ。ほかの期間を選んでみて'; return; } tourIdx = (tourIdx + 1) % l.length; say(l[tourIdx].i); };
    function stopTour() { clearInterval(tourTimer); }
    function startTour() { stopTour(); if (!reduce) tourTimer = window.setInterval(step, 5200); }
    guide.addEventListener('click', () => { step(); startTour(); });

    // ── 期間・無料 ──
    root.querySelectorAll<HTMLButtonElement>('[data-period]').forEach((b) => b.addEventListener('click', () => {
      period = b.dataset.period!; root.querySelectorAll('[data-period]').forEach((x) => x.classList.toggle('is-on', x === b));
      closePop(); render(); tourIdx = -1; step(); startTour();
    }));
    const tog = root.querySelector<HTMLButtonElement>('[data-tog="free"]')!;
    tog.addEventListener('click', () => { freeOnly = !freeOnly; tog.classList.toggle('is-on', freeOnly); tog.setAttribute('aria-pressed', String(freeOnly)); closePop(); render(); tourIdx = -1; step(); });

    render(); home();
    addEventListener('resize', () => apply());
    new IntersectionObserver((ents, ob) => { if (ents.some((x) => x.isIntersecting)) { root.classList.add('is-in'); setTimeout(() => { step(); startTour(); }, reduce ? 0 : 900); ob.disconnect(); } }, { threshold: 0.25 }).observe(stage);
  }
</script>

