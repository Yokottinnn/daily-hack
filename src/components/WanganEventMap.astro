  .wmap.is-ready.is-dragging .wmap-canvas, .wmap.is-ready.wm-instant .wmap-canvas { transition: opacity 0.2s ease; }
  .wmap.wm-instant :global(.wm-pin-scale) { transition: none; }
  .wmap.is-dragging :global(.wm-pin-scale) { transition: none; }
  /* 動かしている間は、CSS で動く絵（波・雲・ピンの点滅）も止める */
