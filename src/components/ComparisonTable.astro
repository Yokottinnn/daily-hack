---
export interface Row {
  service: string;
  cells: string[];
  recommended?: boolean;
}

export interface Props {
  headers: string[];
  rows: Row[];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;
---

<div style="overflow-x: auto;">
  <table class="cmp-table">
    {caption && <caption style="caption-side: top; text-align: left; padding: 8px 0; font-weight: 800; color: var(--ink-2);">{caption}</caption>}
    <thead>
      <tr>
        {headers.map((h) => <th scope="col">{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class={r.recommended ? 'recommended' : ''}>
          <td><strong>{r.service}</strong></td>
          {r.cells.map((c) => <td>{c}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
