---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AboutCard from '../components/AboutCard.astro';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Fieldbeside合同会社',
  url: Astro.site?.toString(),
  logo: new URL('/images/mascot-avatar.png', Astro.site).toString(),
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'n-yokota@fieldbeside.com',
    contactType: 'editorial',
  },
  sameAs: ['https://x.com/heng_ji31590'],
};
---

<BaseLayout title="Daily Hackについて" description="お得を毎日、ハック。Daily HackはFieldbeside合同会社が運営するポイ活・節約・固定費削減の情報メディアです。">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgJsonLd)} />
  <main class="wrap static-page">
    <Breadcrumb items={[
      { label: 'ホーム', href: '/' },
      { label: 'Daily Hackについて' },
    ]} />
    <h1>Daily Hackについて</h1>

    <div style="display: flex; gap: 22px; align-items: center; margin: 24px 0 36px;">
      <div style="width: 110px; height: 110px; border-radius: 50%; overflow: hidden; background: var(--pink-100); border: 4px solid #fff; box-shadow: 0 0 0 1px var(--pink-200); flex-shrink: 0;">
        <img src="/images/mascot-avatar.png" alt="" style="width: 100%; height: 100%; object-fit: cover; object-position: center 20%;" />
      </div>
      <p style="font-size: 18px; line-height: 1.8; margin: 0; color: var(--ink-2);">
        <strong style="color: var(--pink-600);">お得を毎日、ハック。</strong><br />
        あんた、まだ知らないせいで毎月数千円損してるでしょ？ポイ活・節約・固定費削減、私が片っ端から検証して「やらない理由ある？」って教えてあげるサイト。
      </p>
    </div>

    <h2>私たちが伝えたいこと</h2>
    <p>世の中の半分くらいの人、知らないだけで毎月数千〜数万円損してる。あんたもそうかも、ってこと。Daily Hack は、そういう「気づいてない損」を私が一個一個拾ってきて「あんた、これやってないの？」って教えてあげるサイト。難しい話はナシ。今日から実践できる粒度でしか書かないから安心して。</p>
    <p>記事は全部、私が一次情報まで確認したものだけ載せる。広告（PR）が入る記事には必ず「PR」って書いてあるから、騙される心配もない。「広告だから紹介する」じゃなくて「お得だから紹介する」——そこは絶対譲らないから。</p>

    <h2>編集部紹介</h2>
    <p><strong>マスコット: ハッカー子</strong>。少し毒舌だけど本当は親切な、Daily Hack編集部の代弁者。「あんたバカぁ？まだ損してるの？」を口癖に、損してる選択肢を見つけては「しょうがないわね、教えてあげる」と正解を提示します。</p>
    <p><strong>Daily Hack編集部</strong>。Fieldbeside合同会社の情報メディア事業部。X（旧Twitter）アカウント <a href="https://x.com/heng_ji31590" target="_blank" rel="noopener">@heng_ji31590</a> も運営し、最新キャンペーン情報を毎日発信しています。</p>

    <h2>取り扱うテーマ</h2>
    <ul>
      <li><strong>ポイ活</strong> — 楽天ポイント、PayPayポイント、dポイント等の効率的な貯め方</li>
      <li><strong>キャッシュレス・決済</strong> — クレジットカード、QR決済、銀行系ペイの使い分け</li>
      <li><strong>固定費削減</strong> — 通信費、電気代、保険、サブスクの見直し</li>
      <li><strong>金融・口座</strong> — ネット銀行、証券口座、お得な開設キャンペーン</li>
      <li><strong>節約・ライフハック</strong> — 食費、ふるさと納税、節税</li>
    </ul>

    <h2>運営会社情報</h2>
    <table style="border-collapse: collapse; width: 100%; margin: 14px 0;">
      <tbody>
        <tr><th style="text-align: left; padding: 10px 0; border-bottom: 1px solid var(--line); width: 30%;">法人名</th><td style="padding: 10px 0; border-bottom: 1px solid var(--line);">Fieldbeside合同会社</td></tr>
        <tr><th style="text-align: left; padding: 10px 0; border-bottom: 1px solid var(--line);">所在地</th><td style="padding: 10px 0; border-bottom: 1px solid var(--line);">東京都（詳細は<a href="/contact/">お問い合わせ</a>よりご請求ください）</td></tr>
        <tr><th style="text-align: left; padding: 10px 0; border-bottom: 1px solid var(--line);">事業内容</th><td style="padding: 10px 0; border-bottom: 1px solid var(--line);">情報メディアの運営、コンテンツの企画・制作</td></tr>
      </tbody>
    </table>

    <h2>連動メディア</h2>
    <p>X（旧Twitter）でも毎日キャンペーン速報を配信中: <a href="https://x.com/heng_ji31590" target="_blank" rel="noopener">@heng_ji31590（あんたバカぁ？まだ損してるの？速報💸）</a></p>

    <p style="margin-top: 36px;"><a href="/contact/" class="btn btn-primary">お問い合わせはこちら →</a></p>
  </main>
  <AboutCard />
</BaseLayout>
