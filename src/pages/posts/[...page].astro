---
import type { GetStaticPaths, GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PostCard from '../../components/PostCard.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }: GetStaticPathsOptions) => {
  const includeDrafts = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';
  const all = await getCollection('posts', ({ data }) => includeDrafts || !data.draft);
  const sorted = all.sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
  );
  return paginate(sorted, { pageSize: 12 });
};

type Props = { page: Page<CollectionEntry<'posts'>> };
const { page } = Astro.props as Props;

const titleSuffix = page.currentPage > 1 ? `（${page.currentPage}/${page.lastPage}）` : '';
const descBase =
  'Daily Hack の全記事一覧。ポイ活・節約・固定費削減のリアル最新情報を新着順で表示。';
---

<BaseLayout
  title={`記事一覧${titleSuffix}`}
  description={`${descBase}${titleSuffix ? ` 現在 ${page.currentPage} ページ目。` : ''}`}
>
  <section class="cat-hero">
    <div class="wrap">
      <Breadcrumb items={[
        { label: 'ホーム', href: '/' },
        { label: '記事一覧' },
      ]} />
      <div style="display: grid; grid-template-columns: 96px 1fr; gap: 20px; align-items: center;">
        <div style="width: 96px; height: 96px; border-radius: 50%; overflow: hidden; background: var(--pink-100); border: 4px solid #fff; box-shadow: 0 0 0 1px var(--pink-200);">
          <img src="/images/expr-05-smug.png" alt="" style="width: 100%; height: 100%; object-fit: cover; object-position: center 18%;" />
        </div>
        <div>
          <span class="kicker">ALL POSTS</span>
          <h1>記事一覧</h1>
          <p class="lead">これまで公開した記事を新着順で表示。カテゴリで絞り込みたいときはヘッダーメニューから選んで。</p>
          <p style="color: var(--ink-3); font-size: 13px; margin-top: 12px;">
            全 {page.total}記事 ｜ {page.currentPage} / {page.lastPage} ページ
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap" style="padding: 32px 0 16px;">
      <div class="articles">
        {page.data.map((p) => <PostCard post={p} />)}
      </div>

      {page.lastPage > 1 && (
        <nav class="pagination" aria-label="ページネーション">
          {page.url.prev && <a href={page.url.prev} class="page-link" rel="prev">← 前へ</a>}
          <ul class="page-list">
            {Array.from({ length: page.lastPage }).map((_, i) => {
              const n = i + 1;
              const href = n === 1 ? '/posts/' : `/posts/${n}/`;
              const isCurrent = n === page.currentPage;
              return (
                <li>
                  <a
                    href={href}
                    class={`page-num${isCurrent ? ' current' : ''}`}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    {n}
                  </a>
                </li>
              );
            })}
          </ul>
          {page.url.next && <a href={page.url.next} class="page-link" rel="next">次へ →</a>}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>
