---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import UrgentCampaigns from '../components/UrgentCampaigns.astro';
import PostCard from '../components/PostCard.astro';
import ComicBand from '../components/ComicBand.astro';
import Ticker from '../components/Ticker.astro';
import CategoryNav from '../components/CategoryNav.astro';
import AboutCard from '../components/AboutCard.astro';
import PeekCall from '../components/PeekCall.astro';
import AspBanner from '../components/AspBanner.astro';
import a8Banners from '../data/a8-banners.json';
import { postBelongsToCategory } from '../lib/category';

const includeDrafts = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';
const allPosts = await getCollection('posts', ({ data }) => includeDrafts || !data.draft);
const sorted = allPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const latest = sorted.slice(0, 3);
const campaigns = sorted.filter((p) => postBelongsToCategory(p.data, 'campaigns')).slice(0, 3);
// トップの広告: どの読者にも合いやすい提携済みの A8 の広告を 2 つ（ふるさと納税・ホテル予約）
const HOME_ADS = ['s00000023934001', 's00000000218001'].map((id) => a8Banners.banners.find((b) => b.programId === id)).filter((b): b is (typeof a8Banners.banners)[number] => !!b);
---

<BaseLayout title="Daily Hack" description="お得を毎日、ハック。ポイ活・節約・固定費削減のリアル最新情報を、毎日アップデート。">
  <Hero />
  {/* 2026-11-03 忍者AdMAX を外し、A8（会社の口座に入る ASP）の広告に交換した */}
  <div class="wrap"><div class="ad-pair">{HOME_ADS.map((b) => <AspBanner html={b.html} name={b.name} />)}</div></div>
  <UrgentCampaigns posts={campaigns} />

  <section>
    <div class="wrap">
      <div class="sec-head">
        <h2><span class="chibi"><img src="/images/expr-05-smug.png" alt="" /></span>最新記事</h2>
        <a href="/category/comparisons/" class="seeall">すべて見る →</a>
      </div>
      <div class="articles">
        {latest.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <PeekCall />
  <ComicBand />
  <Ticker />
  <CategoryNav />
  <AboutCard />
</BaseLayout>
