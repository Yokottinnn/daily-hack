---
/**
 * 湾岸エリアイベントマップの専用ページ（2026-11-02）。湾岸ライフの一覧にも同じマップを置いている。
 * 「湾岸 イベント 今日」「豊洲 イベント マップ」「有明 今週末 イベント」で来る人のための入口。
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WanganEventMap from '../components/WanganEventMap.astro';
import { WANGAN_AREAS, jpDate, jpRange, todayJst } from '../lib/wangan';
import { mapItems } from '../lib/wangan-map';

const posts = (await getCollection('posts', ({ data }) => !data.draft && (data.category ?? []).includes('wangan-life')))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const today = todayJst();
const items = mapItems(posts, today);
const events = items.filter((i) => i.kind === 'event');
const now = events.filter((e) => e.start <= today && today <= (e.end || e.start));
const next = events.find((e) => e.start > today);
const site = Astro.site!.toString().replace(/\/$/, '');
const ym = `${Number(today.slice(0, 4))}年${Number(today.slice(5, 7))}月`;
const title = `湾岸エリアイベントマップ ${ym}｜豊洲・有明・晴海・月島で今日なにがある？`;
const description = `豊洲・有明・晴海・勝どき・月島・青海（中央区・江東区）のイベントを地図で一覧。${jpDate(today)}時点で開催中${now.length}件・これから${events.length - now.length}件。日付・会場・料金は公式発表どおり。毎朝更新。`;

const faq = [
  { q: '湾岸エリアで今日やっているイベントは？', a: now.length ? `${jpDate(today)}時点で${now.length}件。${now.slice(0, 3).map((e) => `「${e.title}」（${e.place}）`).join('、')}${now.length > 3 ? 'ほか' : ''}。` : `${jpDate(today)}時点で開催中のものは無い。いちばん近いのは${next ? `「${next.title}」（${jpRange(next.start, next.end || undefined)}・${next.place}）` : 'まだ発表されていない'}。` },
  { q: 'これから湾岸で始まるイベントは？', a: next ? `いちばん近いのは「${next.title}」（${jpRange(next.start, next.end || undefined)}・${next.place}）。地図の日付を動かすと、その日に開かれているものだけが出る。` : '発表されたものが出たら、毎朝この地図に足す。' },
  { q: 'このマップはどの地域を扱っている？', a: '中央区の晴海・勝どき・月島・佃・豊海と、江東区の豊洲・有明・東雲・辰巳・青海。港区（お台場・台場・芝浦など）と品川区は扱っていない。' },
  { q: '情報はどこから取っている？いつ更新している？', a: '施設の公式サイト・主催者のプレスリリース・東京都と区の発表。毎朝、新しいイベントの記事を書いてこの地図に足し、終わったイベントは自動で外している。地図の形は国土地理院の地図をもとに作った。' },
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${site}/wangan-map/`,
    inLanguage: 'ja',
    dateModified: today,
    about: WANGAN_AREAS.map((a) => ({ '@type': 'Place', name: `東京都${a.ward}${a.tag}` })),
    mainEntity: {
      '@type': 'ItemList',
      name: `湾岸エリアのイベント（${jpDate(today)}時点）`,
      numberOfItems: events.length,
      itemListElement: events.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Event',
          name: e.title,
          startDate: e.start,
          ...(e.end ? { endDate: e.end } : {}),
          eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
          eventStatus: 'https://schema.org/EventScheduled',
          url: `${site}/posts/${e.slug}/`,
          ...(e.img ? { image: new URL(e.img, site).toString() } : {}),
          ...(e.isFree ? { isAccessibleForFree: true } : {}),
          location: {
            '@type': 'Place',
            name: e.place,
            address: { '@type': 'PostalAddress', streetAddress: e.address, addressCountry: 'JP' },
            ...(e.lat ? { geo: { '@type': 'GeoCoordinates', latitude: e.lat, longitude: e.lon } } : {}),
          },
        },
      })),
    },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<BaseLayout title={title} description={description}>
  {ld.map((x) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(x)} />)}
  <section class="cat-hero" style="padding-bottom: 8px;">
    <div class="wrap">
      <Breadcrumb items={[{ label: 'ホーム', href: '/' }, { label: '湾岸ライフ', href: '/category/wangan-life/' }, { label: 'イベントマップ' }]} />
    </div>
  </section>
  <section>
    <div class="wrap">
      <WanganEventMap posts={posts} headingLevel="h1" title={`湾岸エリアイベントマップ ${ym}`} />

      <div class="sec-head"><h2 id="faq">よくある質問</h2></div>
      <div class="cmp-table-wrap">
        <table class="cmp-table spec-table faq-table">
          <tbody>
            {faq.map((f) => <tr><th>{f.q}</th><td>{f.a}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 16px; font-size: 13px; color: var(--ink-3);">
        地区ごとの記事は
        {WANGAN_AREAS.map((a, i) => <>{i > 0 && '・'}<a href={`/tags/${a.tag}/`}>{a.tag}</a></>)}
        。湾岸の暮らしの記事は <a href="/category/wangan-life/">湾岸ライフの一覧</a>、毎朝のニュースは <a href="/tags/湾岸ニュース/">湾岸ニュース</a>。
      </p>
    </div>
  </section>
</BaseLayout>
