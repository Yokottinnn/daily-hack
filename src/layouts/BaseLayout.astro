---
import DraftCommentWidget from '../components/DraftCommentWidget.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** 下書きの記事など、プレビュー以外でもコメント欄を出すとき */
  reviewTools?: boolean;
}

const {
  title,
  description = 'お得を毎日、ハック。ポイ活・節約・固定費削減のリアル最新情報を、毎日アップデート。',
  ogImage = '/images/mascot-avatar.png',
  noindex = false,
  reviewTools = false,
} = Astro.props;
// プレビュー（下書きを含むビルド・*.pages.dev）では、全ページにコメント欄を出す（2026-11-02 利用者「このページにコメント機能がないよ　バグです」）
const showReviewTools = reviewTools || import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';

const fullTitle = title === 'Daily Hack' ? title : `${title} | Daily Hack`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// 2026-11-03 AdSense に会社のアカウント（fieldbeside.com）で申し込んだ。パブリッシャー ID は公開情報（ページのソースに出る）なので既定値に置く
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || 'ca-pub-3805028233672648';
const adsenseEnabled = adsenseClient.startsWith('ca-pub-');

const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? '';
const ga4Enabled = /^G-[A-Z0-9]+$/.test(ga4Id);

const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID ?? '';
const clarityEnabled = /^[a-z0-9]+$/.test(clarityId) && clarityId.length >= 6;

// GSC verification — CF Pages secret 経由が build に渡らない問題があるため一時的にハードコード
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || 'CILy2IUgMkBjq30SwWsO2FzzntTXnBlvT2pQ0bov96E';
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION ?? '';
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION ?? '';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Daily Hack" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heng_ji31590" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/mascot-avatar.png" />

    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Daily Hack" href="/rss.xml" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts (mockup準拠: Zen Maru Gothic + RocknRoll One のみ) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* 2026-11-07: フォント（日本語で約 1.9 MB）が、ページの準備（地図を動かす処理も）と回線を取り合っていた。
        スマホ相当の回線で測ると、地図が見えるまで 15.1 秒 → フォントを外すと 5.3 秒。ページの準備が終わってから読み込み、届いたら切り替える（見た目は同じ） */}
    <script is:inline>
      (function () {
        var href = 'https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700;900&family=RocknRoll+One&display=swap';
        var add = function () { var l = document.createElement('link'); l.rel = 'stylesheet'; l.href = href; document.head.appendChild(l); };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', add); else add();
      })();
    </script>
    <noscript><link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700;900&family=RocknRoll+One&display=swap" rel="stylesheet" /></noscript>

    <!-- Structured data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Daily Hack',
      url: Astro.site?.toString(),
      description: 'お得を毎日、ハック。',
      publisher: {
        '@type': 'Organization',
        name: 'Fieldbeside合同会社',
      },
    })} />

    <slot name="head" />

    {/*
      **Cloudflare Web Analytics のビーコンは外した**（2026-09-27）。

      token `0dc312c5…` は **Cloudflare アカウントに存在しないサイト**を指していて、
      **データが 1 件も入っていなかった。** アカウントにある RUM サイトは
      `fieldbeside.com`（`73990e57…`）の 1 件だけで、そちらを引いても
      `/posts/…` の PV は 0 件。つまり**このブログの計測には一度も使われていない。**

      全ページで外部スクリプトを 1 本 読んで、何も記録していなかったことになる。

      **アクセスの集計は Cloudflare Zone Analytics に一本化した**（エッジ側なので
      ビーコンが要らない）。`scripts/weekly-blog-report.py` と
      `.github/workflows/pv-archive.yml` がそこから引く。

      **戻すなら、先に daily-hack 用の Web Analytics サイトを作って
      その site_tag を入れること。** 古い token を貼り直しても、また黙って 0 になる。
    */}

    {ga4Enabled && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          // デフォルトでは個別Cookieを拒否、CookieConsent側で同意があれば変更
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
          });
          gtag('config', ga4Id, { anonymize_ip: true });
          // CookieConsent で accept されたら有効化
          try {
            if (localStorage.getItem('daily-hack:cookie-consent') === 'accepted') {
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted',
              });
            }
          } catch(e) {}
        </script>
      </>
    )}

    {clarityEnabled && (
      <script is:inline define:vars={{ clarityId }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}

    {adsenseEnabled && (
      <>
        <meta name="google-adsense-account" content={adsenseClient} />
        {/* 2026-11-07 利用者が「広告の読み込みを後回しにする」を選んだ。スマホ相当で、広告を止めると地図が見えるまで約 3 秒短くなった。
            審査用の印（上の meta）は先頭に残し、広告の本体はページの読み込みが終わってから読む */}
        <script is:inline define:vars={{ adsenseClient }}>
          (function () {
            var add = function () { var s = document.createElement('script'); s.async = true; s.crossOrigin = 'anonymous'; s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsenseClient; document.head.appendChild(s); };
            var later = function () { if ('requestIdleCallback' in window) requestIdleCallback(add, { timeout: 3000 }); else setTimeout(add, 1500); };
            if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true });
          })();
        </script>
      </>
    )}
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    {/* スマホ下部固定の広告は、どのページにも置かない。
        2026-05-31 に外し、09-05 に記事ページにだけ戻し、**10-02 に利用者の指示で再び外した**。
        経緯は docs/ad-slots.md */}
    <CookieConsent />
    {showReviewTools && <DraftCommentWidget />}
  </body>
</html>
