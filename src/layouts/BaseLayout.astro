---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import AdMax from '../components/AdMax.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'お得を毎日、ハック。ポイ活・節約・固定費削減のリアル最新情報を、毎日アップデート。',
  ogImage = '/images/mascot-avatar.png',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'Daily Hack' ? title : `${title} | Daily Hack`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
const adsenseEnabled = adsenseClient.startsWith('ca-pub-');

const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? '';
const ga4Enabled = /^G-[A-Z0-9]+$/.test(ga4Id);

const clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID ?? '';
const clarityEnabled = /^[a-z0-9]+$/.test(clarityId) && clarityId.length >= 6;

const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION ?? '';
const bingVerification = import.meta.env.PUBLIC_BING_VERIFICATION ?? '';
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION ?? '';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Daily Hack" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heng_ji31590" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/mascot-avatar.png" />

    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Daily Hack" href="/rss.xml" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts (mockup準拠: Zen Maru Gothic + RocknRoll One のみ) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700;900&family=RocknRoll+One&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Daily Hack',
      url: Astro.site?.toString(),
      description: 'お得を毎日、ハック。',
      publisher: {
        '@type': 'Organization',
        name: 'Fieldbeside合同会社',
      },
    })} />

    <slot name="head" />

    <!-- Cloudflare Web Analytics（Cookie不要、GDPR配慮、無料） -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "0dc312c59cff43f58507d2b4f669dd82"}'></script>

    {ga4Enabled && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          // デフォルトでは個別Cookieを拒否、CookieConsent側で同意があれば変更
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
          });
          gtag('config', ga4Id, { anonymize_ip: true });
          // CookieConsent で accept されたら有効化
          try {
            if (localStorage.getItem('daily-hack:cookie-consent') === 'accepted') {
              gtag('consent', 'update', {
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
                analytics_storage: 'granted',
              });
            }
          } catch(e) {}
        </script>
      </>
    )}

    {clarityEnabled && (
      <script is:inline define:vars={{ clarityId }}>
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarityId);
      </script>
    )}

    {adsenseEnabled && (
      <>
        <meta name="google-adsense-account" content={adsenseClient} />
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      </>
    )}
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <AdMax slot="dailyhack-sticky-mobile" variant="sticky-mobile" label={false} />
    <CookieConsent />
  </body>
</html>
