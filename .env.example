# SEO / Analytics (本番は Cloudflare Pages の環境変数で設定)
PUBLIC_GSC_VERIFICATION=google-site-verification=xxxx
PUBLIC_BING_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_YANDEX_VERIFICATION=xxxxxxxxxxxxxxxx
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# 内部 (Drafts プレビュー)
PUBLIC_INCLUDE_DRAFTS=false

# Server-only (CI / scripts)
CLOUDFLARE_API_TOKEN=xxx
GA_PROPERTY_ID=xxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
